ERWRITE TABLE dwd_xxx_df PARTITION(ds=3D'${bizdate}')
SELECT * FROM
(
    SELECT a.columns --=E3=80=90=E9=99=A4=E4=BA=86start_date=EF=BC=8Cend_da=
te=E4=B9=8B=E5=A4=96=E7=9A=84=E5=AD=97=E6=AE=B5=E3=80=91
          ,a.start_date
