=98=AF=E4=B9=8B=E5=89=8D=E7=9A=84end_date
          ,CASE WHEN a.end_date =3D '9999-12-31' AND b.pk IS NOT NULL THEN =
'${bizdate}'
                ELSE a.end_date
           END AS end_date
    FROM      ds_ods.dwd_xxx_df a
    LEFT JOIN ds_ods.ods_xxx_update  b
    ON a.pk =3D b.pk
=09WHERE a =3D '${bizdate-1}' -- =E6=98=A8=E5=A4=A9=E7=9A=84=E6=8B=89=E9=93=
=BE=E8=A1=A8
UNION
