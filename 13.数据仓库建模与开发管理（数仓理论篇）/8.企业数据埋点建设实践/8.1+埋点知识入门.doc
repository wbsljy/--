0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level2 lfo2;" ><![if !supportLists]><span style=3D"font-family:微软雅黑;mso-ascii-font-family:'Courier New';mso-hansi-font-family:'Courier New';=20mso-bidi-font-family:'Courier New';font-size:10.0000pt;mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-8.1埋点知识入门-2.1业务需求" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >2.1 业务需求</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level2 lfo2;" ><![if !supportLists]><span style=3D"font-family:微软雅黑;mso-ascii-font-family:'Courier New';mso-hansi-font-family:'Courier New';=20mso-bidi-font-family:'Courier New';font-size:10.0000pt;mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-8.1埋点知识入门-2.2需求拆解" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >2.2 需求拆解</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:微软雅黑;mso-ascii-font-family:Symbol;mso-hansi-font-family:Symbol;=20mso-bidi-font-family:Symbol;font-size:10.0000pt;mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-8.1埋点知识入门-3.埋点方案拆解" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >3.埋点方案拆解</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.为啥要埋点</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >埋点日志采集是数据分析的手段</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，所以还是老生常谈一下，说一说我们为什么要做埋点。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1.1 业务角度</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >首先，什么是业务？广义上是为了满足需求而诞生的具体流程和产品逻辑。业务也可以理解为为了满足用户的某些需求，而所需要的一系列的流程。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >举个例子：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在蚂蚁，他们更多关注的是产品业务。这里的产品业务可以等同与一个产品，也可以包含相互协作的一系列产品，</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在淘宝中，业务也可以细分为产品下不同场景的业务。业务内部有流程可以自闭环，也有一些需要依赖其他业务。因此业务也不是一个孤岛，不同业务之间可能会有千丝万缕的联系。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><br></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1.2 数据角度</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据是支持业务发展的依据，那么是先有业务、再有数据，还是先有数据、再有业务呢？这其实也是个鸡生蛋的问题。有些业务先行，业务上线后再依赖数据做持续迭代，有些是数据先行，从数据分析中发现需求价值，进而产生新的业务。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >现在我们常提的精细化运营更是离不开数据的支撑，通过数据分析发现可运营点，产品迭代方向。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如果我们把数据做一个简单的划分，包括两大类：用户行为数据、业务数据。业务过程数据可能存储在不同的地方，业务的数据库、服务端的日志明细等，这份数据我们这里不讨论。</font> <font face=3D"微软雅黑" >用户行为数据是产品运营分析不可缺少的，通过用户行为我们可以刻画用户画像、抽象人群分层，进行漏斗、留存行为分析等等。用户行为结合业务标签，才能够发挥流量数据分析最大的能量。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >2. 埋点需求</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2.1 业务需求</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >游戏行业的数据需求</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><table class=3DMsoNormalTable  border=3D1  cellspacing=3D0  style=3D"border-collapse:collapse;margin-left:2.4000pt;border:none;=20mso-border-left-alt:0.5000pt solid windowtext;mso-border-top-alt:0.5000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;=20mso-border-bottom-alt:0.5000pt solid windowtext;mso-padding-alt:0.7500pt 0.7500pt 0.7500pt 0.7500pt ;" ><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:1.0000pt solid windowtext;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  style=3D"page-break-after:avoid;mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"font-family:微软雅黑;mso-ansi-fo