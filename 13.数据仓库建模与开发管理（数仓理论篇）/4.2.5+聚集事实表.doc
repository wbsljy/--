<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">set odps.=
sql.mapper.split.size =3D 16;
set odps.sql.groupby.skewindata =3D true;
set odps.sql.reducer.instances =3D 2000;
WITH t_collec_di AS (
SELECT  id
        ,promotion_status
        ,gmt_create
        ,promotion_id
        ,channel_id
        ,IF(collect_src =3D "marketing_interaction_STRATEGY_CENTER&lt;hp_po=
p_up&gt;","ds-plutus-=09s_marketing_interaction_STRATEGY_CENTER&lt;hp_pop_u=
p&gt;",collect_src) AS collect_src
        ,buyer_id
        ,consume_type
        ,consume_id
        ,discountvalue
        ,coupon_value
        ,collect_value
        ,collect_date
        ,collect_local_date
        ,feature
        ,product_code
        ,product_sub_code
        ,promotion_feature
        ,sponsor
        ,snap_id
        ,out_id
        ,coupon_value_usd
        ,collect_value_usd
        ,channel_name
        ,created_by
        ,create_email
        ,create_by_no
        ,created_by_origin
        ,purpose_id
        ,purpose_name
        ,operation_parameter
        ,gmt_modified
        ,distribution_plan_id
        ,tag_id
        ,tag_name
        ,module_id
        ,module_name
        ,page_id
        ,page_name
        ,scene_id
        ,scene_name
        ,distribution_plan_name
        ,start_time
        ,start_local_date
        ,end_time
        ,end_local_date
        ,total_count
        ,available_count
        ,in_use_count
        ,used_count
        ,invalid_count
        ,campaign_id
        ,gcp_page_id
        ,gcp_module_id
        ,tag_union_id
        ,ds
        ,venture
        ,collect_mon
FROM    ds_mkt.dwd_ds_pro_voucher_collect_di
WHERE   ds =3D  '${bizdate}'
)


INSERT OVERWRITE TABLE dws_ds_promotion_collect_1d PARTITION(ds=3D'${bizdat=
e}')
SELECT  'ALL' AS  promotion_id
        ,IF (GROUPING(channel_id) =3D0,channel_id,'ALL') AS  channel_id=20
        ,IF (GROUPING(channel_name) =3D0,channel_name,'ALL') AS  channel_na=
me=20
        ,IF (GROUPING(collect_src) =3D0,collect_src,'ALL') AS  collect_src =
=20
        ,IF (GROUPING(product_code) =3D0,product_code,'ALL') AS  product_co=
de  =20
        ,IF (GROUPING(product_sub_code) =3D0,product_sub_code,'ALL') AS  pr=
oduct_sub_code =20
        ,IF (GROUPING(sponsor) =3D0,sponsor,'ALL') AS  sponsor =20
        ,'SEA' AS  venture  =20
        ,COUNT(1) collect_cnt
        ,sum(collect_value_usd) collect_value
        ,COUNT(DISTINCT concat(venture,'#',buyer_id)) collect_uv
        ,'ALL' AS created_by
        ,'ALL' AS create_by_no
        -- ,IF (GROUPING(created_by) =3D0,nvl(created_by,'unknown'),'ALL') =
AS  created_by
        -- ,IF (GROUPING(create_by_no) =3D0,nvl(create_by_no,'unknown'),'AL=
L') AS  create_by_no
        ,'ALL' AS  purpose_id
        ,IF (GROUPING(purpose_name) =3D0,purpose_name,'ALL') AS  purpose_na=
me
         ,IF (GROUPING(distribution_plan_id) =3D0,nvl(distribution_plan_id,=
'unknown'),'ALL') AS  distribution_plan_id
          ,IF (GROUPING(distribution_plan_name) =3D0,nvl(distribution_plan_=
name,'unknown'),'ALL') AS  distribution_plan_name
           ,IF (GROUPING(scene_id) =3D0,nvl(scene_id,'unknown'),'ALL') AS  =
scene_id
          ,IF (GROUPING(scene_name) =3D0,nvl(scene_name,'unknown'),'ALL') A=
S  scene_name
          ,IF (GROUPING(tag_union_id) =3D0,nvl(tag_union_id,'unknown'),'ALL=
') AS  tag_union_id
          ,IF (GROUPING(tag_name) =3D0,nvl(tag_name,'unknown'),'ALL') AS  t=
ag_name
          ,IF (GROUPING(gcp_page_id) =3D0,nvl(gcp_page_id,'unknown'),'ALL')=
 AS  gcp_page_id
          ,IF (GROUPING(campaign_id) =3D0,nvl(campaign_id,'unknown'),'ALL')=
 AS campaign_id
          ,'ALL' AS gcp_module_id
         ,IF (GROUPING(gcp_module_id) =3D0,nvl(gcp_module_id,'unknown'),'AL=
L') AS gcp_module_id
FROM t_collec_di
GROUP BY ROLLUP(product_code
         ,product_sub_code)
          ,ROLLUP((scene_id,scene_name)
         ,(tag_union_id,tag_name))
         ,cube(
         (channel_id,channel_name)
         ,(purpose_name)
        --  ,(created_by,create_by_no)
         ,collect_src
         ,sponsor
         ,(distribution_plan_id,distribution_plan_name)
         ,gcp_page_id
         ,campaign_id
        ,gcp_module_id
         )
union all
SELECT  IF (GROUPING(promotion_id) =3D0,promotion_id,'ALL')  AS  promotion_=
id
        ,IF (GROUPING(channel_id) =3D0,channel_id,'ALL') AS  channel_id=20
        ,IF (GROUPING(channel_name) =3D0,channel_name,'ALL') AS  channel_na=
me=20
        ,IF (GROUPING(collect_src) =3D0,collect_src,'ALL') AS  collect_src =
=20
        ,IF (GROUPING(product_code) =3D0,product_code,'ALL') AS  product_co=
de  =20
        ,IF (GROUPING(product_sub_code) =3D0,product_sub_code,'ALL') AS  pr=
oduct_sub_code =20
        ,IF (GROUPING(sponsor) =3D0,sponsor,'ALL') AS  sponsor =20
        ,venture AS  venture  =20
        ,COUNT(1) collect_cnt
        ,sum(collect_value_usd) collect_value
        ,COUNT(DISTINCT concat(venture,'#',buyer_id)) collect_uv
        ,'ALL' AS created_by
        ,'ALL' AS create_by_no
        -- ,IF (GROUPING(created_by) =3D0,nvl(created_by,'unknown'),'ALL') =
AS  created_by
        -- ,IF (GROUPING(create_by_no) =3D0,nvl(create_by_no,'unknown'),'AL=
L') AS  create_by_no
        ,'ALL' AS  purpose_id
        ,IF (GROUPING(purpose_name) =3D0,purpose_name,'ALL') AS  purpose_na=
me
         ,IF (GROUPING(distribution_plan_id) =3D0,nvl(distribution_plan_id,=
'unknown'),'ALL') AS  distribution_plan_id
          ,IF (GROUPING(distribution_plan_name) =3D0,nvl(distribution_plan_=
name,'unknown'),'ALL') AS  distribution_plan_name
           ,IF (GROUPING(scene_id) =3D0,nvl(scene_id,'unknown'),'ALL') AS  =
scene_id
          ,IF (GROUPING(scene_name) =3D0,nvl(scene_name,'unknown'),'ALL') A=
S  scene_name
          ,IF (GROUPING(tag_id) =3D0,nvl(tag_id,'unknown'),'ALL') AS  tag_i=
d
          ,IF (GROUPING(tag_name) =3D0,nvl(tag_name,'unknown'),'ALL') AS  t=
ag_name
          ,IF (GROUPING(gcp_page_id) =3D0,nvl(gcp_page_id,'unknown'),'ALL')=
 AS  gcp_page_id
          ,IF (GROUPING(campaign_id) =3D0,nvl(campaign_id,'unknown'),'ALL')=
 AS campaign_id
          ,'ALL' AS gcp_module_id
          ,IF (GROUPING(gcp_module_id) =3D0,nvl(gcp_module_id,'unknown'),'A=
LL') AS gcp_module_id
FROM   t_collec_di
WHERE nvl(scene_name,'unknown')&lt;&gt;'unknown'
GROUP BY venture
            ,ROLLUP(product_code
         ,product_sub_code)
         ,ROLLUP((scene_id,scene_name)
         ,(tag_id,tag_name))
         ,cube(
         (channel_id,channel_name)
         ,(purpose_name)
         ,collect_src
         ,sponsor
         ,(distribution_plan_id,distribution_plan_name)
         ,promotion_id
         ,gcp_page_id
         ,campaign_id
        ,gcp_module_id
         )
;</pre>=20
