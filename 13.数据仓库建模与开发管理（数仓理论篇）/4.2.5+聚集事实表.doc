<p><span style=3D"color: rgb(25,26,31);">=E9=9C=80=E6=B1=82=E8=AF=B4=E6=98=
=8E: =E8=AE=A1=E7=AE=97=E6=AF=8F=E4=B8=AA=E7=94=A8=E6=88=B7=E6=A0=B8=E5=BF=
=83=E9=87=91=E5=B8=81=E6=83=85=E5=86=B5;&nbsp;</span></p>
<p class=3D"auto-cursor-target">=E6=95=B0=E6=8D=AE=E6=9D=A5=E6=BA=90=E8=AF=
=B4=E6=98=8E:&nbsp;</p>
<ul>
<li class=3D"auto-cursor-target">ds_cdm.dwd_ds_trd_core_fulfill_di: =E8=AE=
=A2=E5=8D=95=E8=A1=A8</li>
<li class=3D"auto-cursor-target">ds_cdm.dwd_ds_itr_coin_record_df :=E9=87=
=91=E5=B8=81=E6=A0=B8=E9=94=80=E8=A1=A8</li>
<li class=3D"auto-cursor-target">ds_cdm.dim_lazcoin_localcurrency_exchange_=
rate :=E9=87=91=E5=B8=81=E6=B1=87=E7=8E=87=E8=A1=A8 (1=E5=85=83 =3D10=E9=87=
=91=E5=B8=81 )</li>
<li class=3D"auto-cursor-target">ds_cdm.dim_ds_exchange_rate : =E6=B1=87=E7=
=8E=87=E8=A1=A8</li>
</ul>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">INSERT OV=
ERWRITE TABLE dws_ds_coins_byr_flexicoins_redeem_1d PARTITION (ds =3D '${bi=
zdate}')
SELECT  a.venture
        ,a.buyer_id
        ,a.sales_order_id
        ,SUM(a.actual_gmv * to_usd) AS gmv
        ,SUM(a.coins_value * to_usd) AS coins_value
        ,SUM(b.out_quantity) AS redeemed_coins
        ,AVG((b.out_quantity / c.exchange_rate) / a.unit_price) AS avg_coin=
s_discount_rate
FROM    (
            SELECT  venture
                    ,buyer_id
                    ,sales_order_id
                    ,sales_order_item_id
                    ,sku_id
                    ,unit_price
                    ,actual_gmv
                    ,fulfillment_create_date
                    ,KEYVALUE(extra_info,'flexiCoin_seller') AS coins_value
            FROM    ds_cdm.dwd_ds_trd_core_fulfill_di
            WHERE   ds =3D '${bizdate}'
            AND     venture IN ('ID','MY','PH','SG','TH','VN')
            AND     TO_CHAR(fulfillment_create_date,'yyyymmdd') =3D '${bizd=
ate}'
            AND     is_revenue =3D 1
            AND     is_fulfilled =3D 1
            AND     business_application &lt;&gt; 'ZAL'
            AND     KEYVALUE(extra_info,'flexiCoin_seller') &gt; 0
        ) a
INNER JOIN  (
                SELECT  venture
                        ,buyer_id
                        ,COALESCE(SPLIT_PART(trade_no,'_',1),NULL) AS sales=
_order_id
                        ,business_code
                        ,out_quantity
                FROM    ds_cdm.dwd_ds_itr_coin_record_df
                WHERE   ds =3D MAX_PT('ds_cdm.dwd_ds_itr_coin_record_df')
                AND     event_code =3D 'FREEZE_POINT'
                AND     buyer_id &lt; 4000000001001084255
                AND     buyer_id !=3D 100
                AND     TO_CHAR(create_date,'yyyymmdd') =3D '${bizdate}'
                AND     business_code !=3D 'ds-mobile-platform:COIN_BENEFIT=
_CARD'
            ) b
ON      a.venture =3D b.venture
AND     a.buyer_id =3D b.buyer_id
AND     a.sales_order_id =3D b.sales_order_id
LEFT JOIN   (
                SELECT  venture
                        ,exchange_rate
                FROM    ds_cdm.dim_lazcoin_localcurrency_exchange_rate
            ) c
ON      a.venture =3D c.venture
JOIN    (
            SELECT  venture
                    ,to_usd
            FROM    ds_cdm.dim_ds_exchange_rate
            WHERE   ds =3D '${bizdate}'
            AND     venture IN ('ID','MY','PH','SG','TH','VN')
        ) to_usd
ON      a.venture =3D to_usd.venture
GROUP BY a.venture
            ,a.buyer_id
            ,a.sales_order_id
;</pre>=20
