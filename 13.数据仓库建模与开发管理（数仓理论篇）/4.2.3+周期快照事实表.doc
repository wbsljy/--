<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">CREATE TA=
BLE ods_ds_player_status_log_di (
    log_date     STRING COMMENT '=E6=97=A5=E5=BF=97=E5=88=86=E5=8C=BA=E6=97=
=A5=E6=9C=9F(yyyy-MM-dd)',
    event_time   STRING COMMENT '=E4=BA=8B=E4=BB=B6=E6=97=B6=E9=97=B4(yyyy-=
MM-dd HH:mm:ss)',
    player_id    STRING COMMENT '=E7=8E=A9=E5=AE=B6ID',
    event_type   STRING COMMENT '=E4=BA=8B=E4=BB=B6=E7=B1=BB=E5=9E=8B',
    current_gold INT    COMMENT '=E5=BD=93=E5=89=8D=E9=87=91=E5=B8=81',
    current_level INT  COMMENT '=E5=BD=93=E5=89=8D=E7=AD=89=E7=BA=A7',
    rare_items   ARRAY&lt;STRING&gt; COMMENT '=E6=8C=81=E6=9C=89=E7=A8=80=
=E6=9C=89=E9=81=93=E5=85=B7'
) PARTITIONED BY (log_date STRING)
STORED AS PARQUET;

</pre>=20
</div>
</div>
