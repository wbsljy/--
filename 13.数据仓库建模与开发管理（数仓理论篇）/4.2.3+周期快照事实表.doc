=A1=A8=E7=BB=93=E6=9E=84">=E2=80=8C<span>3.3 =E8=A1=A8=E7=BB=93=E6=9E=84</s=
pan></h2>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">-- =E5=
=91=A8=E6=9C=9F=E5=BF=AB=E7=85=A7=E4=BA=8B=E5=AE=9E=E8=A1=A8=EF=BC=9A=E8=B4=
=A6=E6=88=B7=E4=BD=99=E9=A2=9D=E6=AF=8F=E6=97=A5=E5=BF=AB=E7=85=A7
CREATE TABLE ods_account_balance (
    account_id     STRING    COMMENT '=E8=B4=A6=E6=88=B7ID',
    balance        DECIMAL(18,2) COMMENT '=E8=B4=A6=E6=88=B7=E4=BD=99=E9=A2=
=9D',
    snapshot_date  DATE      COMMENT '=E5=BF=AB=E7=85=A7=E6=97=A5=E6=9C=9F'
)
PARTITIONED BY (dt STRING COMMENT '=E6=8C=89=E5=A4=A9=E5=88=86=E5=8C=BA=EF=
=BC=88=E6=A0=BC=E5=BC=8F=EF=BC=9Ayyyy-MM-dd=EF=BC=89')
STORED AS ORC;</pre>=20
</div>
</div>
