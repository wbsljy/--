<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">CREATE TA=
BLE dwd_ds_player_status_change_di (
    event_time   TIMESTAMP COMMENT '=E7=B2=BE=E7=A1=AE=E5=88=B0=E7=A7=92=E7=
=9A=84=E4=BA=8B=E4=BB=B6=E6=97=B6=E9=97=B4',
    player_id    STRING COMMENT '=E7=8E=A9=E5=AE=B6ID',
    gold_diff    INT    COMMENT '=E9=87=91=E5=B8=81=E5=8F=98=E5=8C=96=E9=87=
=8F',
    level_diff   INT    COMMENT '=E7=AD=89=E7=BA=A7=E5=8F=98=E5=8C=96=E9=87=
=8F',
    rare_items   ARRAY&lt;STRING&gt; COMMENT '=E5=BD=93=E5=89=8D=E6=8C=81=
=E6=9C=89=E9=81=93=E5=85=B7',
    is_daily_last BOOLEAN COMMENT '=E6=98=AF=E5=90=A6=E5=BD=93=E6=97=A5=E6=
=9C=80=E5=90=8E=E4=B8=80=E6=9D=A1=E8=AE=B0=E5=BD=95'
) PARTITIONED BY (dt STRING)
CLUSTERED BY (player_id) INTO 10 BUCKETS;

</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>3. ETL=E5=A4=84=E7=90=86=E4=BB=A3=E7=
=A0=81=EF=BC=88HiveSQL=EF=BC=89</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">INSERT OV=
ERWRITE TABLE dwd_ds_player_status_change_di PARTITION(dt=3D'2025-04-01')
SELECT=20
    event_time,
    player_id,
    current_gold - LAG(current_gold, 1, 0) OVER (PARTITION BY player_id ORD=
ER BY event_time) AS gold_diff,
    current_level - LAG(current_level, 1, 0) OVER (PARTITION BY player_id O=
RDER BY event_time) AS level_diff,
    rare_items,
    (ROW_NUMBER() OVER (PARTITION BY player_id, DATE(event_time) ORDER BY e=
vent_time DESC) =3D 1) AS is_daily_last
FROM ods_ds_player_status_log_di
WHERE log_date =3D '2025-04-01'
  AND event_time IS NOT NULL
  AND player_id IS NOT NULL;

</pre>=20
</div>
</div>
