<h2 style=3D"text-align: left;" id=3D"id-4.2.3=E5=91=A8=E6=9C=9F=E5=BF=AB=
=E7=85=A7=E4=BA=8B=E5=AE=9E=E8=A1=A8-3.5=E4=BB=A3=E7=A0=81=E5=AE=9E=E7=8E=
=B0"><span>3.5 =E4=BB=A3=E7=A0=81=E5=AE=9E=E7=8E=B0</span></h2>
<p style=3D"text-align: left;"><br><span>step1=EF=BC=9A=E6=AF=8F=E6=97=A5=
=E5=88=9D=E5=A7=8B=E5=8C=96=EF=BC=88=E5=85=A8=E9=87=8F=E6=9B=B4=E6=96=B0=EF=
=BC=89</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">-- =E4=BB=
=8E=E4=BA=A4=E6=98=93=E6=B5=81=E6=B0=B4=E8=A1=A8=E8=AE=A1=E7=AE=97=E6=AF=8F=
=E6=97=A5=E8=B4=A6=E6=88=B7=E4=BD=99=E9=A2=9D=EF=BC=88=E5=81=87=E8=AE=BE=E6=
=AF=8F=E6=97=A5=E5=85=A8=E9=87=8F=E6=9B=B4=E6=96=B0=EF=BC=89
INSERT OVERWRITE TABLE dwd_ds_account_balance_df PARTITION (dt=3D'2025-10-0=
1')
SELECT=20
    account_id,
    SUM(amount) AS balance,  -- =E5=81=87=E8=AE=BE=E5=88=9D=E5=A7=8B=E4=BD=
=99=E9=A2=9D=E4=B8=BA0=EF=BC=8C=E6=A0=B9=E6=8D=AE=E4=BA=A4=E6=98=93=E7=B4=
=AF=E5=8A=A0
    DATE('2025-10-01') AS snapshot_date
FROM transactions
WHERE DATE(transaction_time) &lt;=3D '2025-10-01'
GROUP BY account_id;

</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>step2=EF=BC=9A=E6=AF=8F=E6=97=A5=E5=A2=
=9E=E9=87=8F=E6=9B=B4=E6=96=B0</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">-- =E5=90=
=88=E5=B9=B6=E5=89=8D=E4=B8=80=E6=97=A5=E5=BF=AB=E7=85=A7=E5=92=8C=E5=BD=93=
=E6=97=A5=E4=BA=A4=E6=98=93=EF=BC=8C=E7=94=9F=E6=88=90=E6=96=B0=E5=BF=AB=E7=
=85=A7=EF=BC=882025-10-02=EF=BC=89
INSERT OVERWRITE TABLE dwd_ds_account_balance_df PARTITION (dt=3D'2025-10-0=
2')
SELECT=20
    COALESCE(old.account_id, new.account_id) AS account_id,
    COALESCE(old.balance, 0) + COALESCE(new.daily_change, 0) AS balance,  -=
- =E6=9B=B4=E6=96=B0=E4=BD=99=E9=A2=9D
    DATE('2025-10-02') AS snapshot_date
FROM=20
    (-- =E5=89=8D=E4=B8=80=E6=97=A5=E5=BF=AB=E7=85=A7=EF=BC=882025-10-01=EF=
=BC=89
     SELECT account_id, balance=20
     FROM ods_account_balance=20
     WHERE dt =3D '2025-10-01'
    ) old
FULL OUTER JOIN=20
    (-- =E5=BD=93=E6=97=A5=E4=BA=A4=E6=98=93=E6=B1=87=E6=80=BB=EF=BC=882025=
-10-02=EF=BC=89
     SELECT account_id, SUM(amount) AS daily_change
     FROM transactions
     WHERE DATE(transaction_time) =3D '2025-10-02'
     GROUP BY account_id
    ) new
ON old.account_id =3D new.account_id;

</pre>=20
</div>
</div>
