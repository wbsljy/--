<h2 style=3D"text-align: left;" id=3D"id-4.2.3=E5=91=A8=E6=9C=9F=E5=BF=AB=
=E7=85=A7=E4=BA=8B=E5=AE=9E=E8=A1=A8-4.4DWS=E5=B1=82=EF=BC=9A=E5=91=A8=E6=
=9C=9F=E5=BF=AB=E7=85=A7=E8=A1=A8(=E5=91=A8=E6=9C=9F:=E6=97=A5)"><span>4.4 =
DWS=E5=B1=82=EF=BC=9A=E5=91=A8=E6=9C=9F=E5=BF=AB=E7=85=A7=E8=A1=A8(=E5=91=
=A8=E6=9C=9F:=E6=97=A5)</span></h2>
<p style=3D"text-align: left;"><span>1.&nbsp;</span><span>=E5=A4=84=E7=90=
=86=E9=80=BB=E8=BE=91</span></p>
<ul>
<li style=3D"list-style-type: disc;">=E6=8B=89=E9=93=BE=E8=A1=A8=E8=A1=A5=
=E5=85=A8=EF=BC=9A=E5=A4=84=E7=90=86=E6=9C=AA=E4=B8=8A=E6=8A=A5=E6=97=A5=E5=
=BF=97=E7=9A=84=E7=8E=A9=E5=AE=B6=EF=BC=88=E4=BF=9D=E7=95=99=E5=89=8D=E4=B8=
=80=E5=A4=A9=E7=8A=B6=E6=80=81=EF=BC=89</li>
<li style=3D"list-style-type: disc;">=E7=8A=B6=E6=80=81=E8=81=9A=E5=90=88=
=EF=BC=9A=E5=8F=96=E6=AF=8F=E6=97=A5=E6=9C=80=E5=90=8E=E4=B8=80=E6=9D=A1=E6=
=9C=89=E6=95=88=E7=8A=B6=E6=80=81</li>
<li style=3D"list-style-type: disc;">=E5=A2=9E=E9=87=8F=E5=90=88=E5=B9=B6=
=EF=BC=9A=E9=81=BF=E5=85=8D=E5=85=A8=E9=87=8F=E9=87=8D=E5=88=B7</li>
</ul>
<p style=3D"text-align: left;"><span>2. DWS=E5=B1=82=E5=BB=BA=E8=A1=A8=E8=
=AF=AD=E5=8F=A5</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">CREATE TA=
BLE dws_player_daily_status (
    snapshot_date DATE COMMENT '=E5=BF=AB=E7=85=A7=E6=97=A5=E6=9C=9F',
    player_id     STRING COMMENT '=E7=8E=A9=E5=AE=B6ID',
    total_gold    INT COMMENT '=E5=BD=93=E6=97=A5=E6=9C=80=E7=BB=88=E9=87=
=91=E5=B8=81',
    total_level   INT COMMENT '=E5=BD=93=E6=97=A5=E6=9C=80=E7=BB=88=E7=AD=
=89=E7=BA=A7',
    rare_item_cnt INT COMMENT '=E7=A8=80=E6=9C=89=E9=81=93=E5=85=B7=E6=95=
=B0=E9=87=8F'
) PARTITIONED BY (snapshot_date DATE);

</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>3. ETL=E5=A4=84=E7=90=86=E4=BB=A3=E7=
=A0=81=EF=BC=88Spark SQL=EF=BC=89</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: py; gutter: true; theme: Confluence" data-theme=3D"Confluence"># =E8=AF=
=BB=E5=8F=96DWD=E5=B1=82=E5=BD=93=E6=97=A5=E6=95=B0=E6=8D=AE
dwd_df =3D spark.sql("""
SELECT=20
    DATE(event_time) AS snapshot_date,
    player_id,
    gold_diff,
    level_diff,
    rare_items
FROM dwd_ds_player_status_change_di
WHERE dt =3D '2025-04-01' AND is_daily_last =3D true
""")

# =E8=AF=BB=E5=8F=96DWS=E5=B1=82=E5=8E=86=E5=8F=B2=E6=95=B0=E6=8D=AE=EF=BC=
=88=E5=89=8D=E4=B8=80=E5=A4=A9=E5=BF=AB=E7=85=A7=EF=BC=89
prev_dws_df =3D spark.read.table("dws_player_daily_status") \
    .filter("snapshot_date =3D '2025-04-01' - INTERVAL 1 DAY")

# =E5=85=A8=E5=A4=96=E5=85=B3=E8=81=94=E8=A1=A5=E5=85=A8=E6=95=B0=E6=8D=AE
merged_df =3D prev_dws_df.alias("prev").join(
    dwd_df.alias("curr"),
    "player_id",
    "full_outer"
).selectExpr(
    "COALESCE(curr.snapshot_date, prev.snapshot_date + 1) AS snapshot_date"=
,
    "COALESCE(curr.player_id, prev.player_id) AS player_id",
    "COALESCE(prev.total_gold, 0) + COALESCE(curr.gold_diff, 0) AS total_go=
ld",
    "COALESCE(prev.total_level, 0) + COALESCE(curr.level_diff, 0) AS total_=
level",
    "SIZE(COALESCE(curr.rare_items, prev.rare_items)) AS rare_item_cnt"
)

# =E5=86=99=E5=85=A5=E6=96=B0=E5=88=86=E5=8C=BA
merged_df.write.partitionBy("snapshot_date").mode("overwrite").saveAsTable(=
"dws_player_daily_status")

</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>4. DWS=E5=B1=82=E6=95=B0=E6=8D=AE=E7=
=A4=BA=E4=BE=8B</span></p>
<div class=3D"table-wrap">
<table class=3D"wrapped confluenceTable">
<colgroup>=20
<col style=3D"width: 132.4px;">
<col style=3D"width: 132.4px;">
<col style=3D"width: 132.4px;">
<col style=3D"width: 132.4px;">
<col style=3D"width: 132.4px;">=20
</colgroup>
<tbody>
<tr>
