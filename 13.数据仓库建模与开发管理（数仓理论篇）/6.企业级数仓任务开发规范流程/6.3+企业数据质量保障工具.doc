olor:rgb(0,0,0);font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >dsbigdata_iump_my_app.marketing_detail_extension</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"font-family:微软雅黑;color:rgb(0,0,0);font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >圈品</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  style=3D"page-break-after:avoid;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"font-family:微软雅黑;color:rgb(0,0,0);font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >dsbigdata_iump_my_app.promotion_snapshot_dsbigdata</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"font-family:微软雅黑;color:rgb(0,0,0);font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >核销</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3DMsoNormal  style=3D"page-break-after:avoid;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p></td></tr></table><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >三、上游依赖对业务影响描述</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >针对业务库表数据的一些变更，如果没有考虑对离线数据的影响，或者没有及时提前通知给下游，那么可能导致下游大量数据产品出现数据质量问题（数据延迟或数据异常）。例如，数据库做大量数据迁移可能会导致</font><font face=3D"微软雅黑" >TT标done延迟，进而可能导致基线延迟，数据产品不可用；数据库表数据暴增也会导致数据同步任务运行耗时增长，进而导致数据延迟；业务系统数据库表一些关键枚举值变更未通知下游数据端，可能导致下游数据统计结果异常；在大促期间业务库表启用了单元化，如果TT表没有及时配置相应的单元化同步点会导致数据丢失；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >四、</font><font face=3D"微软雅黑" >SLA保障要求</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1、涉及依赖范围内的上游TDDL应用或数据库表的重大变更，要考虑对下游数据端的影响，并提前和DT接口人做好沟通，包括但不限于如下变更：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >①针对数据库进行大量的增删改操作</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（例如数据迁移可产生大量的</font><font face=3D"微软雅黑" >Binlog，可能导致TT标done延迟，进而影响下游8基线数据产出；同一个TDDL APP的下某个MySQL表产生了大量的Binlog也会影响这个APP中其他表的TT标done延迟）；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >②业务库启用单元化</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（如果</font><font face=3D"微软雅黑" >TT表没有及时配置相应的单元化同步点会导致数据丢失）；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >③数据库表新增字段</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（在正式数据产生前，数据端也需要新增相应字段，否则该字段将缺失相应的离线数据）</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9315;业务系统中的一些关键字段的枚举值的变更</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（例如</font><font face=3D"微软雅黑" >auction_auctions中的user_type枚举值的变化，下游大量数据用户利用该字段做业务划分）</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2、紧急情况的处理响应时长：10分钟内响应（响应时长，非解决时长）；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3、发布变更提前通知：提前两个工作日通过钉钉和邮件通知DT接口人，确保通知到位；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4、上游依赖方的交接变更：请提前两个工作日同步给DT接口人，确保上游依赖方全面交接完成，包括此SLA的同步；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(245,34,45);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >5、故障等级定义：包括时长和用户反馈量升级，和备注说明，故障等级定义和基本处理原则详见：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,51,102);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >《</font><font face=3D"微软雅黑" >d</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >sbigdata数据团队故障等级定义和基本原则》</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >备注：如发生上游依赖故障，由于</font><font face=3D"微软雅黑" >SLA不达标则需要承担责任，未约定、未覆盖或未细化到的应场景根据具体原因来判定；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p></div><!--EndFragment--></body></html>

