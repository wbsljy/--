t solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"font-family:微软雅黑;font-weight:bold;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >任务间通过依赖关系定义任务的运行顺序。</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如果节点</font><font face=3D"微软雅黑" >A运行后，节点B才能运行，我们称A是B的上游依赖，或者B依赖A。在DAG中，依赖关系用节点间的箭头表示。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >输出名</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >每个任务（</font><font face=3D"微软雅黑" >Task）输出点的名称。它是您在单个租户（阿里云账号）内设置依赖关系时，用于连接上下游两个任务（Task）的虚拟实体。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >当您在设置某任务与其它任务形成上下游依赖关系时，必须根据输出名称（而不是节点名称或节点</font><font face=3D"微软雅黑" >ID）来完成设置。设置完成后该任务的输出名也同时作为其下游节点的输入名称。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >输出表名</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >输出表名建议配置为当前任务的产出表，正确填写输出表名可以方便下游设置依赖时确认数据是否来自期望的上游表。自动解析生成输出表名时不建议手动修改，输出表名仅作为标识，修改输出表名不会影响</font><font face=3D"微软雅黑" >SQL脚本实际产出的表名，实际产出表名以SQL逻辑为准。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >说明</font> </span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >节点的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >输出名</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >需要全局唯一，而</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >输出表名</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >无此限制。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >调度资源组</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >指用于任务调度的资源组。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >调度参数</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >调度参数是代码中用于调度运行时动态取值的变量。代码在重复运行时若希望获取到运行环境的一些信息，例如日期、时间等，可根据</font><font face=3D"微软雅黑" >DataWorks调度系统的调度参数定义，动态为代码中的变量赋值。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >业务日期</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >通常指的是与业务活动直接相关的日期，这个日期反映了业务数据的实际发生时间。这个概念在离线计算场景中尤为重要，例如在零售业务中，您需要统计</font><font face=3D"微软雅黑" >20241010日的营业额，往往会在20241011日凌晨再开始计算，这时所计算出来的数据实际是20241010日的营业额，这个20241010，就是业务日期。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr><tr><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:1.0000pt solid windowtext;mso-border-left-alt:0.5000pt solid windowtext;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >定时时间</font></span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td><td valign=3Dcenter  style=3D"padding:3.0000pt 3.0000pt 3.0000pt 3.0000pt ;border-left:none;mso-border-left-alt:none;=20border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;border-top:none;=20mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;mso-border-bottom-alt:0.5000pt solid windowtext;" ><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >用户为周期任务设置预期执行的时间点，可精确到分钟级别。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"font-family:微软雅黑;mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >重要</font> </span></b><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >影响任务运行的因素较多，并不意味着定时时间到了，任务就会立即执行。在任务执行前，</font><font face=3D"微软雅黑" >DataWorks会检测上游任务是否运行成功、定时时间是否已达到、调度资源是否充足，当上述条件均已满足后，才开始正式触发任务的运行。</font></span><span style=3D"font-family:微软雅黑;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></td></tr></table><p class=3DMsoNormal ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p></div><!--EndFragment--></body></html>

