: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">-- =E5=81=
=87=E8=AE=BE=E5=A2=9E=E9=87=8F=E8=A1=A8 daily_order_updates =E5=8C=85=E5=90=
=AB=E5=BD=93=E6=97=A5=E7=8A=B6=E6=80=81=E5=8F=98=E6=9B=B4=E7=9A=84=E8=AE=A2=
=E5=8D=95
INSERT OVERWRITE TABLE dwd_xx_order_snapshot_fact PARTITION (dt=3D'2025-10-=
02')
SELECT=20
    COALESCE(old.order_id, new.order_id) AS order_id,
    COALESCE(old.customer_id, new.customer_id) AS customer_id,
    COALESCE(old.created_time, new.created_time) AS created_time,
    COALESCE(new.paid_time, old.paid_time) AS paid_time,        -- =E4=BC=
=98=E5=85=88=E5=8F=96=E6=96=B0=E7=9A=84=E6=94=AF=E4=BB=98=E6=97=B6=E9=97=B4
    COALESCE(new.shipped_time, old.shipped_time) AS shipped_time,
    COALESCE(new.cancelled_time, old.cancelled_time) AS cancelled_time
FROM=20
    (SELECT * FROM dwd_xx_order_snapshot_fact WHERE dt=3D'2025-10-01') old =
 -- =E5=89=8D=E4=B8=80=E6=97=A5=E5=85=A8=E9=87=8F=E6=95=B0=E6=8D=AE
FULL OUTER JOIN=20
    (SELECT * FROM daily_order_updates WHERE dt=3D'2025-10-02') new  -- =E5=
=BD=93=E6=97=A5=E5=A2=9E=E9=87=8F=E6=95=B0=E6=8D=AE
ON old.order_id =3D new.order_id;

</pre>=20
