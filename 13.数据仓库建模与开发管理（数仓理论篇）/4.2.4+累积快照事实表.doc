ERWRITE TABLE dwd_xx_order_snapshot_fact PARTITION (dt=3D'2025-10-03')
SELECT=20
    COALESCE(old.order_id, new.order_id) AS order_id,
    COALESCE(old.customer_id, new.customer_id) AS customer_id,
    COALESCE(old.created_time, new.created_time) AS created_time,
    COALESCE(new.paid_time, old.paid_time) AS paid_time,
    COALESCE(new.shipped_time, old.shipped_time) AS shipped_time,  -- =E6=
=9B=B4=E6=96=B0=E5=8F=91=E8=B4=A7=E6=97=B6=E9=97=B4
