=86=E5=8C=BA=EF=BC=882025-10-04=EF=BC=89
INSERT OVERWRITE TABLE order_snapshot_df PARTITION (dt=3D'2025-10-04')
SELECT=20
    COALESCE(old.order_id, new.order_id) AS order_id,
    COALESCE(old.customer_id, new.customer_id) AS customer_id,
    COALESCE(old.created_time, new.created_time) AS created_time,
    COALESCE(new.paid_time, old.paid_time) AS paid_time,
    COALESCE(new.shipped_time, old.shipped_time) AS shipped_time,
    COALESCE(new.cancelled_time, old.cancelled_time) AS cancelled_time
FROM=20
    (-- =E8=AF=BB=E5=8F=96df=E8=A1=A8=E4=B8=AD=E5=89=8D=E4=B8=80=E6=97=A5=
=EF=BC=882025-10-03=EF=BC=89=E7=9A=84=E6=95=B0=E6=8D=AE=EF=BC=88=E4=BF=9D=
=E7=95=99=E6=9C=80=E8=BF=91n=E5=A4=A9=EF=BC=89 =20
     SELECT * FROM dwd_xxx_order_snapshot_df=20
     WHERE dt =3D '2025-10-03'  -- =E4=BF=9D=E7=95=99=E6=9C=80=E8=BF=913=E5=
=A4=A9=EF=BC=882025-10-01, 2025-10-02, 2025-10-03=EF=BC=89
    ) old
FULL OUTER JOIN=20
    (-- =E5=BD=93=E6=97=A5=E5=A2=9E=E9=87=8F=E6=95=B0=E6=8D=AE=EF=BC=882025=
-10-04=EF=BC=89
     SELECT * FROM daily_order_updates WHERE dt=3D'2025-10-04'
    ) new
ON old.order_id =3D new.order_id;

</pre>=20
