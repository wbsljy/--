<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">-- =E5=81=
=87=E8=AE=BE=E6=BA=90=E8=A1=A8 orders_created =E5=8C=85=E5=90=AB=E5=BD=93=
=E6=97=A5=E5=88=9B=E5=BB=BA=E7=9A=84=E8=AE=A2=E5=8D=95
INSERT OVERWRITE TABLE dwd_xx_order_snapshot_fact PARTITION (dt=3D'2025-10-=
01')
SELECT=20
    order_id,
    customer_id,
    created_time,
    NULL AS paid_time,     -- =E5=88=9D=E5=A7=8B=E7=8A=B6=E6=80=81=E6=9C=AA=
=E6=94=AF=E4=BB=98
    NULL AS shipped_time,  -- =E5=88=9D=E5=A7=8B=E7=8A=B6=E6=80=81=E6=9C=AA=
=E5=8F=91=E8=B4=A7
    NULL AS cancelled_time -- =E5=88=9D=E5=A7=8B=E7=8A=B6=E6=80=81=E6=9C=AA=
=E5=8F=96=E6=B6=88
FROM orders_created
WHERE created_date =3D '2025-10-01';

</pre>=20
