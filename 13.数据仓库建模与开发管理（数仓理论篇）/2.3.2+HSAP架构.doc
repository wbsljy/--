<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">BEGIN STA=
TEMENT SET;

INSERT INTO dw.order_dw.dwd_orders=20
 (
   order_id,
   order_user_id,
   order_shop_id,
   order_product_id,
   order_fee,
   order_create_time,
   order_update_time,
   order_state,
   order_product_catalog_name
 ) SELECT o.*, dim.catalog_name=20
   FROM dw.order_dw.orders as o
   LEFT JOIN dw.order_dw.product_catalog FOR SYSTEM_TIME AS OF proctime() A=
S dim
   ON o.product_id =3D dim.product_id;

INSERT INTO dw.order_dw.dwd_orders=20
  (pay_id, order_id, pay_platform, pay_create_time)
   SELECT * FROM dw.order_dw.orders_pay;

END;</pre>=20
