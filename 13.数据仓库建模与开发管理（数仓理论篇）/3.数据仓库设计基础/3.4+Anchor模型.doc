ft:0.0000pt;=20mso-margin-top-alt:auto;=20mso-margin-bottom-alt:auto;=20text-align:left;=20font-family:宋体;=20font-size:12.0000pt;=20}=20=20span.msoIns{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:underline;=20text-underline:single;=20color:blue;=20}=20=20span.msoDel{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:line-through;=20color:red;=20}=20=20table.MsoNormalTable{=20mso-style-name:普通表格;=20mso-style-parent:"";=20mso-style-noshow:yes;=20mso-tstyle-rowband-size:0;=20mso-tstyle-colband-size:0;=20mso-padding-alt:0.0000pt 5.4000pt 0.0000pt 5.4000pt;=20mso-para-margin:0pt;=20mso-para-margin-bottom:.0001pt;=20mso-pagination:widow-orphan;=20font-family:'Times New Roman';=20font-size:10.0000pt;=20mso-ansi-language:#0400;=20mso-fareast-language:#0400;=20mso-bidi-language:#0400;=20}=20@page{mso-page-border-surround-header:no;=20	mso-page-border-surround-footer:no;}@page Section0{=20margin-top:72.0000pt;=20margin-bottom:72.0000pt;=20margin-left:72.0000pt;=20margin-right:72.0000pt;=20size:612.0000pt 792.0000pt;=20mso-header-margin:36.0000pt;=20mso-footer-margin:36.0000pt;=20}=20div.Section0{page:Section0;}</style></head><body style=3D"tab-interval:21pt;" ><!--StartFragment--><div class=3D"Section0" ><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >3.4 Anchor模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"18"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >1.Anchor建模与第六范式</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor建模(Anchor Modeling)是由Lars. R&#246;nnb&#228;ck推出的一种建模方法与建模工具都免费的数据模型体系：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在线建模工具：</font></span><span><a href=3D"http://www.anchormodeling.com/modeler/latest/" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >http://www.anchormodeling.com/modeler/latest/</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >建模工具源码：</font></span><span><a href=3D"https://github.com/Roenbaeck/anchor" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >https://github.com/Roenbaeck/anchor</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在线建模工具目前支持输出</font><font face=3D"微软雅黑" >SQL Server/Oracle/PostgreSQL建表语句，也可以自行扩展开源建模工具的语法支持范围。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >对比经典建模技术的首发时间</font><font face=3D"微软雅黑" >(经典书籍初版时间或学术会议公开发表)可以看出，Anchor建模属于新兴技术：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. Anchor Modeling：2007</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. Data Vault: 2000</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3. 维度建模: 1996</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4. (第三)范式建模：1992</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >内网及中文互联网中对</font><font face=3D"微软雅黑" >Anchor模型的详细介绍较少</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，短介绍可参见</font><font face=3D"微软雅黑" >“引用1”，长介绍可参见“引用2”，大家</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >对</font><font face=3D"微软雅黑" >Anchor模型共同描述是：是对Data Vault模型的更进一步的范式化处理（符合6NF）</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，所以把</font><font face=3D"微软雅黑" >Anchor建模称作“第六范式建模”也并无不可。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >介绍</font><font face=3D"微软雅黑" >Anchor模型首先需要介绍第六范式（6NF）：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >6NF的前提是符合5NF，5NF介绍参见“引用2”，6NF要求每一个非主键列都有自己与主键一起的独立表(K-V表)，而独立表无法再分解，6NF应用于时序数据库较多，特点很灵活，可以很方便的处理维度的变化，但表间的Join成本相应也较大。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >通俗来说，对于</font><font face=3D"微软雅黑" >6NF，要求每个数据表只能拥有一个公共主键和一个属性，而这种表被称为独立表（K-V表）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor模型通过对数据表字段的最细拆解，实现了6NF中的独立表分解，从而具备了极致扩展的能力：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. 传统关系数据表在添加或删除字段需要修改表结构，而在Anchor模型中只需要新建或删除属性表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. 传统关系数据表在采用拉链表记录历史时，即使只有一个字段需要更新的，也必须增加一整条含所有字段的记录，而在Anchor模型中只需要对单个属性表增加一条仅含一个字段记录即可。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"18"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >2.Anchor模型的设计理念与特点</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor建模的基本概念有：</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. Anchors(实体)：实体以及事实类的实体</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. Ties(关系)：表示多个实体间的关系</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3. Attributes(属性)：以K-V形式表示的实体属性</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4. Knots(公共属性)：公共公用、枚举型的属性</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >“引用2”中用Data Vault作为对比来介绍Anchor建模，但是很多同学对Data Vault也不是很熟悉，本文就用大家熟悉的维度建模来对比，来介绍下Anchor建模的概念：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. Anchors可以理解为维度建模中的“事实”的再拆解。比如商品下单这个事实，可以拆解为，用户、商品、下单事件这三个实体或事实类实体，而Anchors中存储的是实体或事实的代理键。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. Ties表示多个Anchors之间的关系，承担了维度建模中事实表的关系表述功能，但去除了属性值存储功能，仅仅保留二个至多个的键值对的关系表述。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3. Attributes承接了维度建模中事实表的属性值存储功能，将用户、商品、下单事件三类实体中的所有属性(表中字段)全部继续打散成一个个独立的Attributes表，其内部使用相应实体的代理键(外键)来将属性和原有的实体与事实关联。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4. Knots相当于维度建模方法论中星座模型内的公共维度表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor建模的另外两个特点是：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. Ties(关系)和Attributes(属性)也分为静态不变和存历史两种，即自带字段级拉链表的功能。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. 上述所有表(Anchors/Ties/Attributes/Knots)内都带有一个额外的metadata_id字段</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. metadata_id用于关联自定义的元信息表，所有上述所有表内的每条记录的元信息</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. 记录的元信息包括创建时间、修改时间等自定义信息</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor建模特点总结来说：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. 是一种非常敏捷的数据库建模方法，适用于结构和内容都随时间变化频繁的场景</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2. 数据以K-V结构化将字段值存储在各Attributes表，对字段的K-V化存储相当于显式的采用了列式存储的方式，字段间的关系不再对应到“数据库表”的多个，而是对应到“Ties表”中的记录，其比三范式建模更底层</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3. 适合大量稀疏表的场景(很多列是NULL)，因为所有字段全是极窄的独立表，所以NULL值直接不存储即可</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4. </font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >适合处理时序数据</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，模型理论中天然有包含历史变化这个概念</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >5. 因为仅添加，不更改历史，所以天然适合敏捷式增量迭代开发</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >6. Anchor模型非常底层且复杂，适合搭配具备自动维护功能的模型管理软件</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >7. Anchor模型需要大量使用View或触发器来构建逻辑视图，便于用户和上层开发者理解，而逻辑视图的计算成本较高，因此简单的Anchor模型实现常常给人性能较差的感觉。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"18"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >3.Anchor建模与思想的业内实践</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor建模目前业内直接应用较少，“马蜂窝旅游”可能有部分应用（参见“引用4”文章中Anchor模型介绍部分）。仔细想想现在很多大数据存储产品中的列存储模式，是不是跟Anchor模型比较类似呢？具备列存储能力的存储产品，其把字段按列拆分的过程，即完成了Anchor建模中对数据表字段的拆解过程，而列存储单元本身就像Anchor建模中的Attributes表。不同的是，Anchor中的Ties仅存储实体间的关系，属性与实体间的归属关系，只保存在Attributes表的表名中（按特定的命名规范），而列存储产品内部的元数据管理，直接存储了每个列存储单元和事实性实体(关系表本身)的关系。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"18"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >4.引用</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >引用</font><font face=3D"微软雅黑" >1：数据建模</font></span><span><a href=3D"https://www.atatech.org/articles/151719" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >https://www.atatech.org/articles/151719</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >引用</font><font face=3D"微软雅黑" >2：《大数据之路-阿里巴巴大数据实践》数据建模 章节 节选</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor模型</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor对Data Vault模型做了进一步规范化处理，Lars. R&#246;nnb&#228;ck的初衷是设计一个高度可扩展的模型，其核心思想是所有的扩展只是添加而不是修改，因此将模型规范到6NF，基本变成了k-v结构化模型。我们看一下Anchor模型的组成。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1）Anchors：类似于Data Vault的Hub，代表业务实体，且只有主键。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2）Attributes：功能类似于Data Vault的Satellite，但是它更加规范化，将其全部k-v结构化，一个表只有一个&gt;Anchors的属性描述。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3）Ties：就是Anchors之间的关系，单独用表来描述，类似于Data Vault的Link，可以提升整体模型关系的扩展能力。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4）Knots：代表那些可能会在多个Anchors中公用的属性的提炼，比如性别、状态等这种枚举类型且被公用的属性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在上述四个基本对象的基础上，又可以细划分为历史的和非历史的，其中历史的会以时间戳加多条记录的方式记录数据的变迁历史。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Anchor模型的创建者以此方式来获取极大的可扩展性，但是也会增加非常多的查询join操作。创建者的观点是，数据仓库中的分析查询只是基于一小部分字段进行的，类似于列存储结构，可以大大减少数据扫描，从而对查询性能影响较小。一些有数据表裁剪（Table Elimination）特性的数据库如MariaDB的出现，还会大量减少join操作。但是实际情况是不是如此，还有待商榷。下面是一个Anchor模型图（来自Anchor Modeling-Agile Information Modeling in Evolving Data Environments，作者Lars. R&#246;nnb&#228;ck），如图所示。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"248"  src=3D"~tmp{33535866-eff5-45ac-aa52-199c5572caca}1576310.files/~tmp{33535866-eff5-45ac-aa52-199c5572caca}15763103640.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >建模工具</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"254"  src=3D"~tmp{33535866-eff5-45ac-aa52-199c5572caca}1576310.files/~tmp{33535866-eff5-45ac-aa52-199c5572caca}15763103910.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >引用</font><font face=3D"微软雅黑" >3：数据库之六大范式(1NF/2NF/3NF/BCNF/4NF/5NF)详解 </font></span><span><a href=3D"https://blog.csdn.net/weixin_43433032/article/details/89293663" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >https://blog.csdn.net/weixin_43433032/article/details/89293663</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >引用</font><font face=3D"微软雅黑" >4：美团点评运营数据产品化应用与实践</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span><a href=3D"https://tech.meituan.com/2018/02/11/mtdp-travel-yydp-present.html" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >https://tech.meituan.com/2018/02/11/mtdp-travel-yydp-present.html</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></div><!--EndFragment--></body></html>

