le-name:普通表格;=20mso-style-parent:"";=20mso-style-noshow:yes;=20mso-tstyle-rowband-size:0;=20mso-tstyle-colband-size:0;=20mso-padding-alt:0.0000pt 5.4000pt 0.0000pt 5.4000pt;=20mso-para-margin:0pt;=20mso-para-margin-bottom:.0001pt;=20mso-pagination:widow-orphan;=20font-family:'Times New Roman';=20font-size:10.0000pt;=20mso-ansi-language:#0400;=20mso-fareast-language:#0400;=20mso-bidi-language:#0400;=20}=20@page{mso-page-border-surround-header:no;=20	mso-page-border-surround-footer:no;}@page Section0{=20margin-top:72.0000pt;=20margin-bottom:72.0000pt;=20margin-left:72.0000pt;=20margin-right:72.0000pt;=20size:612.0000pt 792.0000pt;=20mso-header-margin:36.0000pt;=20mso-footer-margin:36.0000pt;=20}=20div.Section0{page:Section0;}</style></head><body style=3D"tab-interval:21pt;" ><!--StartFragment--><div class=3D"Section0" ><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"宋体" >3.2.3 星座模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-3.2.3星座模型-1.什么是星座模型" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >1.什么是星座模型</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-3.2.3星座模型-2.星型模型示例" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2. 星型模型示例</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-3.2.3星座模型-3.企业实际案例" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >3.企业实际案例</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"宋体" >1.什么是星座模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库是由多个主题组成的，包含多个事实表，而维表是公共的，可以被多个事实表关联使用，这种模式可以看做</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >星型模式的汇集</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >，因而称作星系模式或者事实星座模式。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;结构</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;letter-spacing:0.0000pt;=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;：多个事实表共享公共维度表，形成“多事实表+共享维度”的复杂结构。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;查询效率&#8204;：中等（需处理多个事实表和共享维度）。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;冗余度&#8204;：维度表可能冗余，但共享维度减少重复建设。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;复杂度&#8204;：高，适合企业级多业务过程整合。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >适用场景</font><font face=3D"宋体" >&#8204;</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level2 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >企业级数据仓库（整合销售、库存、促销等多个业务过程）。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level2 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >需要跨业务主题分析（如分析促销活动对库存和销售的影响）。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"宋体" >2. 星型模型示例</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;mso-ansi-font-weight:bold;" ><font face=3D"宋体" >案例</font>1</span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >：假设有一个连锁店的销售数据仓库，记录销售相关的日期、地区、商店和产品，其星型模式如图所示。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >如下图中，订单事实表和物流事实表都使用了商品和区域维表。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"314"  src=3D"~tmp{296c727b-01d3-481b-8624-ec1216b8f45a}1249550.files/~tmp{296c727b-01d3-481b-8624-ec1216b8f45a}1249550672.png" ></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >Sales Fact&nbsp;是唯一的事实表，Dim_time、Dim_branch、Dim_location和Dim_item是四个维度表。每个维度表的xxx_key字段是它们的主键。事实表time_key、item_key、branch_key、location_key四个字段构成了事实表的联合主键，同时这个四个字段也是外键，分别引用对应的四个维度表的主键。units_sold是事实表的一个非主键列，代表销售量，是用于计算和分析的度量值。维度表的非主键列表示维度的附加属性。</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"宋体" >3.企业实际案例</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >举一个例子</font>:&nbsp;</span><b style=3D"mso-bidi-font-weight