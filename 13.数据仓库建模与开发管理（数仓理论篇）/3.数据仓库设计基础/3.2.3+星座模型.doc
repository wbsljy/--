<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">
set odps.sql.mapjoin.memory.max=3D6048;
WITH pro_item_sponsor AS=20
(
SELECT =20
        t_all_discount_info.venture
        ,t_all_discount_info.promotion_id
        ,product_code
        ,prom_type_group
        ,prom_type
        ,promotion_amount_usd
        ,promotion_amount_local
        ,promotion_plt_amt_usd
        ,promotion_plt_amt_local
        ,promotion_slr_amt_usd
        ,promotion_slr_amt_local
        ,actual_gmv_local
        ,actual_gmv_usd
        ,t_all_discount_info.sales_order_item_id
        ,check_out_id
        ,buyer_id
        ,sales_order_id
        ,sku_id
        ,product_id
        ,seller_id
        ,bu_id
        ,is_revenue
        ,is_finance_plt
        ,is_normal_promo
        ,fulfillment_create_date
        ,t_edc_discount_info.edc_earn_min
        ,t_edc_discount_info.edc_earn_local
        ,t_edc_discount_info.edc_earn_usd
FROM    (
            SELECT  venture
                    ,promotion_id
                    ,product_code
                    ,prom_type_group=20
                    ,prom_type
                    ,fulfillment_create_date
                    ,promo_amt * exchange_rate AS promotion_amount_usd
                    ,promo_amt AS promotion_amount_local
                    ,plt_promo_amt * exchange_rate AS promotion_plt_amt_usd
                    ,plt_promo_amt AS promotion_plt_amt_local
                    ,slr_promo_amt * exchange_rate AS promotion_slr_amt_usd
                    ,slr_promo_amt AS promotion_slr_amt_local
                    ,actual_gmv AS actual_gmv_local
                    ,actual_gmv * exchange_rate AS actual_gmv_usd
                    ,sales_order_item_id
                    ,checkout_id as check_out_id
                    ,buyer_id
                    ,sales_order_id
                    ,sku_id
                    ,product_id
                    ,seller_id
                    ,bu_id
                    ,is_revenue
                    ,is_finance_plt
                    ,is_normal_promo
                    FROM    ds_cdm.dwd_dsbigdata_pro_ord_itm_promo_fulfill_=
di
                    WHERE   ds =3D '${bizdate}'
                    AND     promotion_id IS NOT NULL
        ) t_all_discount_info
LEFT JOIN   (
                SELECT  promotion_id
                        ,GET_JSON_OBJECT(noDeductionDiscount,'$.amount') AS=
 edc_earn_min
                        ,sg_udf:decimalisation(GET_JSON_OBJECT(noDeductionD=
iscount,'$.amount'),venture) * exchange_rate AS edc_earn_usd
                        ,sg_udf:decimalisation(GET_JSON_OBJECT(noDeductionD=
iscount,'$.amount'),venture) AS edc_earn_local
                        ,sales_order_item_id
                        ,venture
                FROM    (
                            SELECT  all_discount_info
                                    ,sales_order_item_id
                                    ,exchange_rate
                                    ,venture
                            FROM    ds_cdm.dwd_dsbigdata_trd_ord_itm_fulfil=
l_di
                            WHERE   ds =3D '${bizdate}'
                            AND     all_discount_info LIKE '%noDeductionDis=
count%'
                        ) tt
                LATERAL VIEW sg_udf:Bi_json_array(all_discount_info,'promot=
ionId','noDeductionDiscount') sale_discount_info AS promotion_id,noDeductio=
nDiscount
                WHERE   GET_JSON_OBJECT(noDeductionDiscount,'$.amount') IS =
NOT NULL
                AND     GET_JSON_OBJECT(noDeductionDiscount,'$.amount') &gt=
; 0
            ) t_edc_discount_info
ON      t_all_discount_info.venture =3D t_edc_discount_info.venture
AND     t_all_discount_info.promotion_id =3D t_edc_discount_info.promotion_=
id
AND     t_all_discount_info.sales_order_item_id =3D t_edc_discount_info.sal=
es_order_item_id
)

INSERT OVERWRITE TABLE dwd_dsbigdata_pro_promotion_redeem_di PARTITION (ds =
=3D'${bizdate}',venture)
SELECT  coll.id AS collect_id
        ,t_pro_item.promotion_id
        ,t_pro_item.product_code
        ,COALESCE(promotion.tool_code,pro_snapshot.tool_code) AS tool_code
        ,t_pro_item.buyer_id
        ,t_pro_item.check_out_id
        ,t_pro_item.sales_order_id
        ,t_pro_item.sales_order_item_id
        ,t_pro_item.actual_gmv_usd
        ,t_pro_item.actual_gmv_local
        ,t_pro_item.promotion_amount_usd
        ,t_pro_item.promotion_amount_local
        ,t_pro_item.promotion_slr_amt_usd
        ,t_pro_item.promotion_plt_amt_usd
        ,t_pro_item.promotion_slr_amt_local
        ,t_pro_item.promotion_plt_amt_local
        ,t_pro_item.sku_id
        ,t_pro_item.product_id
        ,t_pro_item.seller_id
        ,t_pro_item.bu_id
        ,coll.distribution_plan_id
        ,coll.distribution_plan_name
        ,coll.scene_id
        ,coll.scene_name
        ,coll.page_id
        ,coll.page_name
        ,coll.module_id
        ,coll.module_name
        ,coll.tag_id
        ,coll.tag_name
        ,coll.tag_union_id
        ,coll.pool_id
        ,coll.pool_name
        ,promotion.prom_type as prom_type
        ,promotion.prom_sub_type as prom_sub_type
        -- ,t_pro_item.prom_type_group AS prom_type      =20
        -- ,t_pro_item.prom_type AS prom_sub_type  =20
        ,promotion.event_id            =20
        ,promotion.event1_id      =20
        ,promotion.event2_id      =20
        ,promotion.event3_id      =20
        ,promotion.event1_name    =20
        ,promotion.event2_name    =20
        ,promotion.event3_name    =20
        ,promotion.purpose_id     =20
        ,promotion.purpose_name   =20
        ,promotion.purpose1_id    =20
        ,promotion.purpose2_id    =20
        ,promotion.purpose3_id    =20
        ,promotion.purpose1_name  =20
        ,promotion.purpose2_name  =20
        ,promotion.purpose3_name
        ,venture_category1_id    =20
        ,venture_category2_id    =20
        ,venture_category3_id    =20
        ,venture_category4_id    =20
        ,venture_category5_id    =20
        ,venture_category6_id    =20
        ,venture_category1_name_en
        ,venture_category2_name_en
        ,venture_category3_name_en
        ,venture_category4_name_en
        ,venture_category5_name_en
        ,venture_category6_name_en
        ,cancel_date
        ,coll.result_detail_json
        ,coll.is_vulcan_config
        ,usertrack_id as utdid=20
        ,COALESCE(t_pro_item.edc_earn_min,0) AS edc_earn_min
        ,COALESCE(t_pro_item.edc_earn_local,0) AS edc_earn_local
        ,COALESCE(t_pro_item.edc_earn_usd,0) AS edc_earn_usd
        ,t_pro_item.is_revenue
        ,COALESCE(coll.hit_user_group_codes,GET_JSON_OBJECT(coll.result_det=
ail_json,'$.hitUserGroupCodes')) as hit_user_group_codes
        ,COALESCE(coll.benefit_group_scene,GET_JSON_OBJECT(coll.result_deta=
il_json,'$.scene')) as benefit_group_scene
        ,coll.ext_source
        ,coll.biz_code
        ,coll.extra_info
        ,t_pro_item.is_finance_plt
        ,t_pro_item.is_normal_promo
        ,coll.collect_track_info
        ,fulfillment_create_date
        ,t_order.paid_amount as paid_amount_local=20
        ,t_order.paid_amount_usd
        ,t_pro_item.venture=20
FROM    pro_item_sponsor t_pro_item
JOIN   (
        SELECT  =20
                buyer_id
                ,sales_order_item_id
                ,venture =20
                ,paid_amount * exchange_rate as paid_amount_usd=20
                ,paid_amount
                ,venture_category1_id    =20
                ,venture_category2_id    =20
                ,venture_category3_id    =20
                ,venture_category4_id    =20
                ,venture_category5_id    =20
                ,venture_category6_id    =20
                ,venture_category1_name_en
                ,venture_category2_name_en
                ,venture_category3_name_en
                ,venture_category4_name_en
                ,venture_category5_name_en
                ,venture_category6_name_en
                ,cancel_date
                ,usertrack_id
        FROM    ds_cdm.dwd_dsbigdata_trd_core_di
        WHERE   ds =3D '${bizdate}'
        ) t_order
ON      t_pro_item.sales_order_item_id =3D t_order.sales_order_item_id
AND     t_pro_item.buyer_id =3D t_order.buyer_id
AND     t_pro_item.venture =3D t_order.venture
LEFT JOIN   (
                SELECT  promotion_id
                        ,venture
                        ,channel_id
                        ,channel_name
                        ,prom_type
                        ,prom_sub_type
                        ,event_id
                        ,event1_id
                        ,event2_id
                        ,event3_id
                        ,event1_name
                        ,event2_name
                        ,event3_name
                        ,purpose_id
                        ,purpose_name
                        ,purpose1_id
                        ,purpose2_id
                        ,purpose3_id
                        ,purpose1_name
                        ,purpose2_name
                        ,purpose3_name
                        ,tool_code
                FROM    ds_cdm.dim_dsbigdata_pro_promotion
                WHERE   ds =3D MAX_PT('ds_cdm.dim_dsbigdata_pro_promotion')
            ) promotion
ON      CAST(t_pro_item.promotion_id AS BIGINT) =3D promotion.promotion_id
AND     t_pro_item.venture =3D promotion.venture
LEFT JOIN   (
                SELECT  trade_order_line_id
                        ,activity_id
                        ,detail_id
                        ,tool_code
                        ,venture
                        ,ROW_NUMBER() OVER (PARTITION BY venture,activity_i=
d,trade_order_line_id ORDER BY snapshot_modified DESC) AS row_num
                FROM    ds_cdm.dwd_dsbigdata_pro_promotion_snapshot_df
                WHERE   ds =3D MAX_PT('ds_cdm.dwd_dsbigdata_pro_promotion_s=
napshot_df')
            ) pro_snapshot
ON      CAST(t_pro_item.sales_order_item_id AS BIGINT) =3D pro_snapshot.tra=
de_order_line_id
AND     CAST(t_pro_item.promotion_id AS BIGINT) =3D pro_snapshot.activity_i=
d
AND     pro_snapshot.row_num =3D1
LEFT JOIN   (
                SELECT  *
                FROM    ds_cdm.dwd_dsbigdata_pro_voucher_collect_di
                WHERE   ds &gt;=3D TO_CHAR(DATEADD(TO_DATE('${bizdate}','yy=
yymmdd'),-180,'dd'),'yyyymmdd')
            ) coll
ON      pro_snapshot.detail_id =3D coll.id
AND     pro_snapshot.activity_id =3D CAST(coll.promotion_id AS BIGINT)
;</pre>=20
</div>
</div>
    </div>
