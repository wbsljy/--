0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-3.2.3星座模型-2.星型模型示例" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >2. 星型模型示例</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-3.2.3星座模型-3.企业实际案例" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >3.企业实际案例</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.什么是星座模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据仓库是由多个主题组成的，包含多个事实表，而维表是公共的，可以被多个事实表关联使用，这种模式可以看做</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >星型模式的汇集</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，因而称作星系模式或者事实星座模式。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;结构</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;letter-spacing:0.0000pt;=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;：多个事实表共享公共维度表，形成“多事实表+共享维度”的复杂结构。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;查询效率&#8204;：中等（需处理多个事实表和共享维度）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;冗余度&#8204;：维度表可能冗余，但共享维度减少重复建设。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;复杂度&#8204;：高，适合企业级多业务过程整合。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >适用场景</font><font face=3D"微软雅黑" >&#8204;</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level2 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >企业级数据仓库（整合销售、库存、促销等多个业务过程）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l1 level2 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >需要跨业务主题分析（如分析促销活动对库存和销售的影响）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >2. 星型模型示例</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >案例</font><font face=3D"微软雅黑" >1</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >：假设有一个连锁店的销售数据仓库，记录销售相关的日期、地区、商店和产品，其星型模式如图所示。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如下图中，订单事实表和物流事实表都使用了商品和区域维表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"314"  src=3D"~tmp{d0292e5c-2755-47dc-a6e7-953c16de480b}1576310.files/~tmp{d0292e5c-2755-47dc-a6e7-953c16de480b}1576310788.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D22  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Sales Fact 是唯一的事实表，Dim_time、Dim_branch、Dim_location和Dim_item是四个维度表。每个维度表的xxx_key字段是它们的主键。事实表time_key、item_key、branch_key、location_key四个字段构成了事实表的联合主键，同时这个四个字段也是外键，分别引用对应的四个维度表的主键。units_sold是事实表的一个非主键列，代表销售量，是用于计算和分析的度量值。维度表的非主键列表示维度的附加属性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >3.企业实际案例</font></span></b><b><span style=3D"