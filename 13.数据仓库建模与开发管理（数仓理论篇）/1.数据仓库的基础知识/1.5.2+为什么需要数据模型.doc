so-margin-top-alt:auto;=20mso-margin-bottom-alt:auto;=20text-align:left;=20font-family:宋体;=20font-size:12.0000pt;=20}=20=20span.msoIns{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:underline;=20text-underline:single;=20color:blue;=20}=20=20span.msoDel{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:line-through;=20color:red;=20}=20=20table.MsoNormalTable{=20mso-style-name:普通表格;=20mso-style-parent:"";=20mso-style-noshow:yes;=20mso-tstyle-rowband-size:0;=20mso-tstyle-colband-size:0;=20mso-padding-alt:0.0000pt 5.4000pt 0.0000pt 5.4000pt;=20mso-para-margin:0pt;=20mso-para-margin-bottom:.0001pt;=20mso-pagination:widow-orphan;=20font-family:'Times New Roman';=20font-size:10.0000pt;=20mso-ansi-language:#0400;=20mso-fareast-language:#0400;=20mso-bidi-language:#0400;=20}=20@page{mso-page-border-surround-header:no;=20	mso-page-border-surround-footer:no;}@page Section0{=20margin-top:72.0000pt;=20margin-bottom:72.0000pt;=20margin-left:72.0000pt;=20margin-right:72.0000pt;=20size:612.0000pt 792.0000pt;=20mso-header-margin:36.0000pt;=20mso-footer-margin:36.0000pt;=20}=20div.Section0{page:Section0;}</style></head><body style=3D"tab-interval:21pt;" ><!--StartFragment--><div class=3D"Section0" ><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.5.2 为什么需要数据模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在前面我们一再强调需要</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >数据模型是数据仓库建设的核心基石</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，那么数据模型究竟在数据仓库的建设中如何应用</font><font face=3D"微软雅黑" >? 为什么这么重要呢？</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据仓库中的数据模型是对数据仓库中的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >数据组织结构、关系和存储方式</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >的抽象描述</font><font face=3D"微软雅黑" >,目的是为了高效支持数据分析和决策,确保数据的一致性,完整性和易用性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.数据模型的层次划分在数仓中的应用</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据仓库的模型设计</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >同样</font></span></b><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >也可以</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >分为概念模型、逻辑模型、物理模型三个层次，从抽象到具体逐步落地：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1. 概念模型</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 作用：从</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >业务角度</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >描述数据的核心实体、关系和业务规则，不涉及具体技术细节，是业务人员和技术人员的沟通桥梁。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 应用：通过简化的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >实体</font><font face=3D"微软雅黑" >-关系图</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（</font><font face=3D"微软雅黑" >ER图）等方式，</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >梳理核心业务对象</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（如</font><font face=3D"微软雅黑" >“用户”“订单”“产品”）及它们之间的关联（如“用户下单购买产品”），明确数据仓库的业务边界和核心主题。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2.逻辑模型</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 作用：在</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >概念模型基础上</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >细化数据结构</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，定义具体的实体、属性、关系及数据约束，</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >不依赖具体的数据库技术</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 应用：数据仓库中</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >常用维度模型作为逻辑模型</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，明确事实表（存储度量值，如</font><font face=3D"微软雅黑" >“销售额”）和维度表（存储描述信息，如“时间”“用户”）的结构，以及它们之间的关联（如事实表通过“用户ID”关联用户维度表）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3. 物理模型</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 作用：将逻辑模型转化为具体的数据库存储结构，依赖于数据库类型（如Hive、ClickHouse、StarRocks等），考虑存储效率、查询性能等技术细节。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#9702; 应用：定义表的存储格式（如列存、行存）、分区方式（如按日期分区）、索引设计（如对常用查询字段建索引）等，确保数据分析时的高效性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >2. ER模型与维度模型在数仓中的应用</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2.1 ER模型（实体-关系模型）</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >定义：</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >通过实体、属性、关系描述数据，强调实体之间的关联完整性，追求数据的规范化（减少冗余）</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >特点：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >适用于</font><font face=3D"微软雅黑" >OLTP（联机事务处理）系统，如电商的订单系统，需支持高频的增删改操作，保证数据一致性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >结构可能复杂，包含大量表和关联（如</font><font face=3D"微软雅黑" >“订单”关联“用户”“产品”“物流”等多个表），不适合直接用于复杂的数据分析。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在数据仓库中的应用：通常用于源系统的建模，数据仓库在抽取数据时会参考源系统的</font><font face=3D"微软雅黑" >ER模型，但不会直接采用其结构。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2.2 维度模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >定义：</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >专为数据分析设计，以</font><font face=3D"微软雅黑" >“事实表+维度表”为核心</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，强调数据的易用性和查询效率，允许适度冗余。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >特点：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >事实表：存储业务度量值（如</font><font face=3D"微软雅黑" >“销量”“金额”），以及与维度表关联的外键（如“时间ID”“产品ID”）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >维度表：存储描述性信息（如</font><font face=3D"微软雅黑" >“时间维度”包含年/月/日，“产品维度”包含名称/类别/价格），结构扁平，方便过滤和分组。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在数据仓库建模中，</font> <font face=3D"微软雅黑" >适用于</font><font face=3D"微软雅黑" >OLAP（联机分析处理），如数据分析平台，支持快速的聚合、钻取（如从“年销售额”钻取到“月销售额”）等操作。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >常见形式：星型模型（一个事实表关联多个维度表，维度表之间无关联）和雪花模型（维度表可进一步关联子维度表，规范化程度略高，但查询复杂度增加）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >3.大数据场景下的数据模型设计重要性</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >大数据场景下更需要良好的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >数据模型设计</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >来更好地组织和存储数据，以便在性能、成本、效率和质量之间取得最佳平衡。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1）性能：良好的数据模型能帮助我们快速查询所需要的数据，减少数据的I/O吞吐。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2）成本：良好的数据模型能极大地减少不必要的数据冗余，也能实现计算结果复用，极大地降低大数据系统中的存储和计算成本。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3）效率：良好的数据模型能极大地改善用户使用数据的体验，提高使用数据的效率。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >4）质量：良好的数据模型能改善数据统计口径的不一致性，减少数据计算错误的可能性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >4.数据仓库中的数据模型设计可以解决哪些问题</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D20  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >主要能够帮助我们解决以下的一些问题：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Times New Roman';mso-fareast-font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >1.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >进行全面的业务梳理，改进业务流程。在业务模型建设的阶段，能够帮助我们的企业或者是管理机关对本单位的业务进行全面的梳理。通过业务模型的建设，我们应该能够全面了解公司的业务架构图和整个业务的运行情况，能够将业务按照特定的规律进行分门别类和程序化，同时，帮助我们进一步的改进业务的流程，提高业务效率，指导我们的业务部门的生产。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Times New Roman';mso-fareast-font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >2.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >建立全方位的数据视角，消灭信息孤岛和数据差异。通过数据仓库的模型建设，能够为企业提供一个整体的数据视角，不再是各个部门只是关注自己的数据，而且通过模型的建设，勾勒出了部门之间内在的联系，帮助消灭各个部门之间的信息孤岛的问题，更为重要的是，通过数据模型的建设，能够保证整个企业的数据的一致性，各个部门之间数据的差异将会得到有效解决。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Times New Roman';mso-fareast-font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >3.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >解决业务的变动和数据仓库的灵活性。通过数据模型的建设，能够很好的分离出底层技术的实现和上层业务的展现。当上层业务发生变化时，通过数据模型，底层的技术实现可以非常轻松的完成业务的变动，从而达到整个数据仓库系统的灵活性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:'Times New Roman';mso-fareast-font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >4.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >帮助数据仓库系统本身的建设。通过数据仓库的模型建设，开发人员和业务人员能够很容易的达成系统建设范围的界定，以及长期目标的规划，从而能够使整个项目组明确当前的任务，加快整个系统建设的速度。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p></div><!--EndFragment--></body></html>

