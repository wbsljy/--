ft;=20font-family:宋体;=20font-size:12.0000pt;=20}=20=20span.msoIns{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:underline;=20text-underline:single;=20color:blue;=20}=20=20span.msoDel{=20mso-style-type:export-only;=20mso-style-name:"";=20text-decoration:line-through;=20color:red;=20}=20=20table.MsoNormalTable{=20mso-style-name:普通表格;=20mso-style-parent:"";=20mso-style-noshow:yes;=20mso-tstyle-rowband-size:0;=20mso-tstyle-colband-size:0;=20mso-padding-alt:0.0000pt 5.4000pt 0.0000pt 5.4000pt;=20mso-para-margin:0pt;=20mso-para-margin-bottom:.0001pt;=20mso-pagination:widow-orphan;=20font-family:'Times New Roman';=20font-size:10.0000pt;=20mso-ansi-language:#0400;=20mso-fareast-language:#0400;=20mso-bidi-language:#0400;=20}=20@page{mso-page-border-surround-header:no;=20	mso-page-border-surround-footer:no;}@page Section0{=20margin-top:72.0000pt;=20margin-bottom:72.0000pt;=20margin-left:72.0000pt;=20margin-right:72.0000pt;=20size:612.0000pt 792.0000pt;=20mso-header-margin:36.0000pt;=20mso-footer-margin:36.0000pt;=20}=20div.Section0{page:Section0;}</style></head><body style=3D"tab-interval:21pt;" ><!--StartFragment--><div class=3D"Section0" ><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.5.1 什么是数据模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.数据模型概念</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据模型就是数据组织和存储方法，是数据特征的抽象，通过</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >抽象的实体及实体之间联系</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >的形式，来表示现实世界中事物的相互关系的一种映射，也是对数据背后业务的抽象表达，可以用一个公式表示其结构：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据模型</font> <font face=3D"微软雅黑" >=3D 「数据组件 + 组件间关系 + 规约」</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;font-size:10.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >数据组件</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >指</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >各类业务对象或实体</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，对应到数据模型的图形化表达上，一般是「点」，常见的数据组件有业务对象（如：用户、商家）、表（比如：物理表）、指标等；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;font-size:10.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >组件间的关系</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >就是</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >多个数据组件之间的各种关系</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，对应到数据模型的图形化表达上，一般是「边」，常见的组件间的关系有</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >关联关系</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（如用户与商品之间，商品与商家之间）、</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >泛化关系</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >（如：用户与支付宝用户，商家与小程序商家）；</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;font-size:10.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >规约</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >指各类组件及关系的约束条件，如数据组件的命名约束、关联关系的方向约束、主外键约束等等。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据组件、组件间关系及规约的不同，形成了不同的数据模型，不同的数据模型，也对应着不同的构建流程，后续针对具体数据模型的时候再展开介绍。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在这里，数据模型表现和抽象的是实体和实体之间的关系，通过对实体和实体之间关系的定义和描述，来表达实际的业务中具体的业务关系。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >2.从层次上划分</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据仓库模型是数据模型中针对特定的数据仓库应用系统的一种特定的数据模型，</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >从层级上看</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，依次分为：概念模型、逻辑模型、物理模型：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如下图所示。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"142"  src=3D"~tmp{c675470a-b096-4749-8925-edd081181622}1576310.files/~tmp{c675470a-b096-4749-8925-edd081181622}1576310836.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >通过上面的图形，我们能够很容易的看出在整个数据仓库建模过程中，我们需要经历一般三个过程</font><font face=3D"微软雅黑" >:</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >概念模型：</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >是一种面向用户、面向客观世界的模型，</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >用抽象的概念名词来抽象表达业务</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，按数据模型的结构，概念模型对应的数据组件一般是各类数据实体，如：业务对象（用户、商家、商品</font><font face=3D"微软雅黑" >...），业务活动（交易、投保、配送...）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >逻辑模型：</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >逻辑模型既面向用户，又面向物理系统，</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >它是在概念模型的基础上，扩展概念的属性实现的</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，如用户这个概念模型数据组件，扩展性别、年龄、住址等等属性，形成一个表格，逻辑模型的载体可以是一个文档，也可以是一张虚拟表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >物理模型：</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >主要是根据逻辑模型，</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >基于物理系统的特性进行针对性的适配</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，如：分区、存储结构、索引策略、冗余等等，载体一般是物理表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >因此，在整个数据仓库的模型的设计和架构中，既涉及到业务知识，也涉及到了具体的技术，我们既需要了解丰富的行业经验，同时，也需要一定的信息技术来帮助我们实现我们的数据模型，最重要的是，我们还需要一个非常适用的方法论，来指导我们自己针对我们的业务进行抽象，处理，生成各个阶段的模型。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >除此之外</font><font face=3D"微软雅黑" >, </font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据仓库建模领域中两种比较重要的数据模型</font><font face=3D"微软雅黑" >,分别</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >关系数据模型和维度数据模型</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >3.ER模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在数据仓库领域，经常会听到两个名字，一个是</font><font face=3D"微软雅黑" >Bill Inmon和Ralph Kimball。 Inmon最早提出数据仓库的概念，在构建数据仓库过程中，主张自顶向下的设计，先设计好数仓的整体架构，然后进行局部设计，而</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Kimball正好相反，主张自底向上设计，先根据各个业务主题进行设计，然后通过维度模型将数据仓库整合起来</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >。目前</font><font face=3D"微软雅黑" >Kimball的维度建模普遍被大家采用。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"468"  height=3D"244"  src=3D"~tmp{c675470a-b096-4749-8925-edd081181622}1576310.files/~tmp{c675470a-b096-4749-8925-edd081181622}15763101799.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >ER模型：数据仓库之父Bill Inmon提出的建模方法是从一个企业的高度设计一个3NF模型，用实体关系（Entity Relationship,ER)模型描述企业业务，在范式理论上符合3NF。后来</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Inmon提出的数据建模方法被称为&#8204;</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >企业信息工厂（</font><font face=3D"微软雅黑" >Corporate Information Factory, CIF）&#8204;或&#8204;企业级数据仓库（Enterprise Data Warehouse, EDW）.</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(39,41,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >了解</font><font face=3D"微软雅黑" >ER 模型如何在数据仓库中的应用 , 必需了解</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >Inmon的三层架构，即操作型系统、企业数据仓库（EDW）和数据集市，以及EDW中的三范式（3NF）设计</font></span></b><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(39,41,51);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >. </font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如下图为</font><font face=3D"微软雅黑" >Inmon构建过程示例：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span><img width=3D"468"  height=3D"183"  src=3D"~tmp{c675470a-b096-4749-8925-edd081181622}1576310.files/~tmp{c675470a-b096-4749-8925-edd081181622}15763102362.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Inmon构建数仓过程，从全局角度出发，主张采用三范式的进行构建，该模式数据冗余小，但是在使用时相对繁琐，通常需要多次关联才能取到我们需要的数据。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3.1 三层架构设计&#8204;</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >1.&#8204;操作型系统（业务系统）&#8204;：企业内部的业务系统数据作为数据源。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >2.&#8204;企业数据仓库（EDW）&#8204;：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >特点：</font> </span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >采用</font><font face=3D"微软雅黑" >&#8204;三范式（3NF）&#8204;设计</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，消除冗余，确保数据一致性。存储最细粒度的业务数据（如每笔交易记录）</font><font face=3D"微软雅黑" >, 支持灵活的历史分析。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >3.数据集市（Data Marts）&#8204;：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >特点：基于</font><font face=3D"微软雅黑" >EDW构建的</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >部门级或主题级数据集市</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，可选用维度模型（星型</font><font face=3D"微软雅黑" >/雪花模型）优化查询性能。&#8204;</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >数据集市是</font><font face=3D"微软雅黑" >EDW的子集</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >，按需派生，而非独立建设。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;3.2 企业级的视角&#8204;</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l2 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;统一数据模型&#8204;：EDW需覆盖企业所有业务领域，确保跨部门数据的一致性。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l2 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;数据集成&#8204;：从分散的源系统抽取、清洗、转换数据，整合到EDW中，形成“单一版本的事实”。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l2 level1 lfo2;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;3.3 自顶向下构建&#8204;</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l0 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"margin-left:36.0000pt;mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >先构建企业级全局的</font><font face=3D"微软雅黑" >EDW，再按需派生出数据集市（</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >按部门或分析主题构建，如销售、财务等</font><font face=3D"微软雅黑" >, 使用星型/雪花模型优化查询性能</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;text-align:left;=20mso-list:l0 level1 lfo3;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:微软雅黑;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >&#8204;强调长期规划&#8204;，初期投入大, 对业务和模型设计要求比较高 , 但扩展性强。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:54.0000pt;=20mso-para-margin-left:0.0000gd;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;=20mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >4.维度模型</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >维度模型：是数据仓库领域的</font><font face=3D"微软雅黑" >Ralph Kimball 大师所倡导的。从分析决策的需求构建模型，为分析需求服务，数据组织的方式是为了优化海量数据的查询和分析。</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >典型的代表是星型模型，以及在一些特殊场景下使用雪花模型</font><font face=3D"微软雅黑" >(节约存储 ,提升模型扩展性的场景)</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >。维度建模中是以事实表和维度表为主。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如下图为</font><font face=3D"微软雅黑" >Kimball构建过程示例：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span><img width=3D"468"  height=3D"199"  src=3D"~tmp{c675470a-b096-4749-8925-edd081181622}1576310.files/~tmp{c675470a-b096-4749-8925-edd081181622}15763103309.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >这里举一个例子说明维度模型</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >维度数据模型专注于特定业务流程的业务问题，下图展示的是用维度模型分析招生情况。可以根据学生所在的区域（</font><font face=3D"微软雅黑" >Zone）、学校名称（School）、学期（Semester）以及学生是否接受财政资助（Financial Aid）来查看招生信息。</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >维度层次</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >可以从一个区域（</font><font face=3D"微软雅黑" >Zone）上升到地区（Region）和国家（Country），从学期（Semester）上升到学年（Year），从学校名称（Name）上升到学校等级（Level）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在这个例子中，用到了图形方法</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >“轴表示法（Axis Notation）”</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >来建模，对于那些不习惯阅读传统数据建模语法的人来说，</font><font face=3D"微软雅黑" >“轴表示法”是一种非常有效的沟通工具。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >关系和维度数据模型都基于同样的业务过程（如录取情况的例子所示）。不同点在于关系代表的含义不同。在关系模型中，关系连线表示业务规则</font><font face=3D"微软雅黑" >(</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >如外键约束</font><font face=3D"微软雅黑" >, “学生表”通过外键关联“学校表”，表示一个学生必须属于某个存在的学校</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >)。而在维度模型中，实体之间的连线表示用于说明业务问题的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;mso-ansi-font-weight:bold;=20mso-bidi-font-weight:normal;" ><font face=3D"微软雅黑" >维度间的关联切换</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >路径</font><font face=3D"微软雅黑" >. </font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span><img width=3D"468"  height=3D"405"  src=3D"~tmp{c675470a-b096-4749-8925-edd081181622}1576310.files/~tmp{c675470a-b096-4749-8925-edd081181622}15763104028.png" ></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >Kimball 维度建模是目前在数据仓库领域中使用最为广泛的、也最得到认可和接纳的一项技术。 &nbsp;目前很多互联网大厂比如BAT数据团队工作规范就是基于它来开展</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >个人补充：【数据仓库建模：星型模型</font> <font face=3D"微软雅黑" >vs 雪花模型】</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >一、前提概念（必先理解）：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >事实表：记录业务</font><font face=3D"微软雅黑" >“动作/度量”的表（如：充值金额、订单金额、登录次数）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >维度表：记录业务</font><font face=3D"微软雅黑" >“描述/属性”的表（如：用户信息、商品信息、日期、地区）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >二、星型模型（</font><font face=3D"微软雅黑" >Star Schema）</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 定义：一个中心事实表直接连接多个维度表，所有维度表都是“扁平化”的，不再拆分。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 特点：维度表有数据冗余（例如地区名、商品类别直接写在同一个维度表里）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 比喻：像海星，中间一个圆（事实），四周直接插满触角（维度）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 优点：查询性能好（Join路径短、只有一层），业务人员易懂。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 缺点：存储空间大（冗余数据多），维度层级变更时维护麻烦。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >三、雪花模型（</font><font face=3D"微软雅黑" >Snowflake Schema）</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 定义：对星型模型中的维度表进一步“规范化”（拆分），将一个大维度表拆成多张关联的子维度表。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 特点：像雪花分叉，表结构呈多层链状（如：商品维度 → 拆出品牌维度 → 拆出产地维度）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 比喻：像雪花结晶，层级细分，分支复杂。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 优点：节省存储（去除了冗余的文本重复），扩展性强（层级关系变化只需改子表）。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- 缺点：Join层级多，查询性能下降（关联表多），逻辑复杂不易理解。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >四、直接解释你括号里的场景：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- "节约存储"：例如千万条充值记录无需反复存“北京市/朝阳区”长字符串，雪花模型只存个地区代码，关联地区表查详情，极大节省硬盘空间。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >- "提升模型扩展性"：例如行政区划变更（县改市），雪花模型只需修改最底层的地区子表一次，上层维表和海量事实表完全不受影响，无需动历史数据。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >五、一句话总结：</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >星型是</font><font face=3D"微软雅黑" >“空间换时间”（冗余换速度），雪花是“时间换空间”（拆分换节省）；数仓绝大多数场景首选星型，只在维度层级极深或存储压力极大时选用雪花。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3D19  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso