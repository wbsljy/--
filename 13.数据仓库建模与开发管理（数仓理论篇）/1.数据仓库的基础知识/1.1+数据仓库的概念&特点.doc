pt;=20mso-footer-margin:36.0000pt;=20}=20div.Section0{page:Section0;}</style></head><body style=3D"tab-interval:21pt;" ><!--StartFragment--><div class=3D"Section0" ><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"宋体" >1.1 数据仓库的概念&特点</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-1.数据仓库的概念" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >1.&#8194;数据仓库的概念</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level1 lfo1;" ><![if !supportLists]><span style=3D"font-family:Symbol;mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >&#183;<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-2.数据仓库的特点" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2.数据仓库的特点</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level2 lfo1;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-2.1面向主题性" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2.1&#8194;面向主题性</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level2 lfo1;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-2.2集成性" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2.2 集成性</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level2 lfo1;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-2.3相对稳定性" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2.3 相对稳定性</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:72.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l0 level2 lfo1;" ><![if !supportLists]><span style=3D"font-family:'Courier New';mso-fareast-font-family:宋体;font-size:10.0000pt;=20mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-1.1数据仓库的概念&特点-2.4反映历史变化" ><u><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" >2.4 反映历史变化</span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;" >1.&nbsp;数据仓库的概念</span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库</font> <font face=3D"宋体" >从字面上可以简单的理解成存储数据仓库</font> ,就像存储粮食的仓库 ,粮食是经过从农田到粮仓也是经过收割、晾晒、分类一系列处理才存储到粮仓.</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"367"  height=3D"245"  src=3D"~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}135022.files/~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}135022568.png" ></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >那我们的数据仓库呢</font>?&nbsp; 数据仓库 存储的是</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >数据</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;,而且是</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >有组织的数据</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >(</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >不同数据建模方法会有不同的组织数据的方式</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >), 除此之外我们建设的数据仓库是</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >有一定边界的</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >, 就像粮仓一样, 几乎每个乡镇都有一个集中的储粮站,&nbsp; 数据仓库的规模可能是</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >企业也可能是业务级别</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >, 几乎没有多个企业和业务共建数据仓库, 因为这个不现实, 一方面是实现和管理难度也很大, 其次涉及数据安全和共享的问题, 比如阿里内部有很多不同的BU(业务单元), 比如淘宝、优酷、蚂蚁、lazada, 这些不同的BU都是要建设不同的BU的数据仓库 ,彼此数据都不互通.</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >只要有数据</font>, 就会涉及到</span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >管理</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" >,&nbsp; 就像粮食也会做分级存储管理 ,过了保质期的粮食会被从粮仓清理出去. 数据也是一样的, 会有集中存储 ,集中管理.&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >所以数据仓库应该是这样的</font>, 从业务系统(一般是关系型数据库)、 埋点日志(手机上的各类app背后都在默默采集你的数据上报) 通过数据同步工具进入数据仓库中, 数据仓库是分层的, 这些</span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >原始数据构成了</font>ods层</span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"400"  height=3D"300"  src=3D"~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}135022.files/~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}1350221161.png" ></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >接着</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >从</font>ods层, 进行数据建模生成了dwd、dws层, 最后dws层的指标经过在ads层加工组装</span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >提供给使用数据的业务人员</font>,&nbsp; 如下面的图 ,回答粮仓的类比, 粮食出仓以后, 粮食</span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >看做</font>ODS层、把磨好包装好的各类面粉看做CDM层、把加工好的挂面、饺子皮等等成型的产品看做成应用层.</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span><img width=3D"400"  height=3D"290"  src=3D"~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}135022.files/~tmp{dfc5859c-3569-48d5-b0df-70f88f9be25c}1350221450.png" ></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >假如你想吃面条、他想吃饺子是不是都得自己下地去割小麦、建磨面厂磨面粉，整个过程中还要保障干净、运输、湿度等等，这样效率低、重复建设明显是得不偿失，所以</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(23,43,77);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >数据开发人员</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >就需要建设一套高效的数据仓库模型，统一收割、按照一定的规章制度和用户需求加工成不同的面粉品类包装存储起来，对于那些市场上高频需要的我们还可以提前加工成挂面销售，其他的应用就自己可以拿相应的面粉自己加工，大大提升了效率，降低了总体的拥有成本</font>,&nbsp;所以我们本门课程就是要讲述这些建模方法, </span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >让大家了解什么是数据建模</font>, 如何建设数仓，数仓的规范， 数仓的企业应用场景;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >企业里面建设数据仓库的目的肯定是更高效的存储、管理、分析</font>, 通过数据仓库中的数据来驱动业务增长, 数据仓库建设目的最终还是要回归到提供业务价值这条主线上来;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >好了</font>,&nbsp; 接下来我们用标准的IT语言来总结下数据仓库的概念</span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库是伴随着信息与决策支持系统的发展过程产生的。在数据仓库进入中国之前已在国外使用了挺长一段时间，总结下来数据仓库是将来自不同数据源的</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >数据集中存储、管理、分析的集中式数据库</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库之父比尔</font><font face=3D"宋体" >&#183;恩门（Bill Inmon）在1991年出版的“Building the Data Warehouse”一书中所提出的定义被广泛接受——数据仓库（Data Warehouse）是一个面向主题的（Subject Oriented）、集成的（Integrated）、相对稳定的（Non-Volatile）、反映历史变化（Time Variant）的数据集合，数据仓库的目标是用于支持分析和决策(Decision Making Support)。它是一个过程 ，一个解决方案，一套方法论，不是一个具体产品。这个定义有些复杂并目难以理解，下面我们将它分开来进行说明，也就是我们下面要学习的数据仓库的四个特点。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,255);=20mso-ansi-font-weight:bold;" >2.数据仓库的特点</span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库特点是啥</font>?&nbsp; 讲这个之前, 大家就要想想业务上常用的存储数据的是什么 ?&nbsp; 嗯, 是数据库 ,&nbsp; 当然数据类型有很多 ,这里我不展开哈, 我们讲的数据仓库特点, 主要对比就是传统的关系型数据库, ORACLE, MYSQL,PG 这种, 这些数据库的应用场景主要是事务处理.&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >2.1&nbsp;面向主题性</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >比如</font> <font face=3D"宋体" >一个电商</font>APP&nbsp; 后台对应很多个系统, 比如商品展现, 这里就有商品系统 , 下单 就有交易系统支持, 领券、用券有权益系统在支持, 开通会员 有会员系统在支持, 这些系统背后用的数据库就是关系型数据库,&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >他们是按照业务功能划分的</font>. 回到数据仓库上, 我们关注的是这些业务系统背后的数据有什么, 比如下单业务环节, 业务关注的是有多少人下单, 贡献了多少gmv这些, 所以我们数据仓库出现就是解决数据分析而诞生的, 而分析就是要分主题 ,</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >自然数据仓库的其中</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >一个特点就是面向主题</font> ,这是数据仓库显著区别与数据库的最大特点</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >.</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p>&nbsp;</o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据仓库主要面向分析主题，因此按照</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;mso-ansi-font-weight:bold;" ><font face=3D"宋体" >主题</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >来组织，而不是按照</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;mso-ansi-font-weight:bold;" ><font face=3D"宋体" >应用程序</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >或者</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;mso-ansi-font-weight:bold;" ><font face=3D"宋体" >业务流程</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >组织数据，主题是业务关心的一类业务或问题。例如：销售、客户、产品等。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;mso-ansi-font-weight:bold;" ><font face=3D"宋体" >举例说明</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >：数据仓库被设计成辅助人们分析数据。例如，一个公司要分析产品销售数据，就可以建立一个专注于销售的数据主题，使用这个数据主题，就可以回答类似于</font><font face=3D"宋体" >“去年哪款产品是最畅销的”这样的问题。这个场景下的销售，就是一个数据主题，而这种通过划分主题定义数据仓库的能力，就使得数据仓库是面向主题的。主题域是对某个主题进行分析后确定的主题的边界，客户、销售、商品都是可能划分的主题域。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >实战说明</font>:&nbsp;</span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >在企业里你是没有机会去划分主题的</font>, 主题域是一个从公司业务全局视角来进行主题的划分, 作为一个数据开发, 是没有资历和机会去做主题域的划分 ;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >Q1.&nbsp;主题域划分一般由谁负责？&#8204;参与人有哪些?&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;资深</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据架构师负责</font> ,</span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >主导主题域的定义和逻辑设计，确保技术可行性。比如根据业务需求设计主题域边界，规范命名和分层规则</font>;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据分析师提供</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(51,51,51);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >业务视角的输入</font>, 其实代表业务方,&nbsp;明确各主题域的业务含义和数据范围。</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >&#8204;Q2.&nbsp;主题域划分是否必须做？&#8204;</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >不一定要做</font> , 业务模式比较固定的可以去做 , 比如银行, 金融信贷业务,&nbsp; 但是非常大的公司业务复杂, 可能需要去做, 但是实际上没有(公司很大, 业务很多, 统一划分主题域几乎是不可能完成和落地推行的事情);&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >Q3. 主题域和数据域的区别?&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >主题域和数据域对于小白理解起来非常抽象</font>,&nbsp; 我从应用场景角度来说</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >主题域：主要用于</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >数据集市</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >的划分，即将数据集市按照分析视角进行切分。这里的</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >主题可以理解</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >对业务中某一个核心分析领域的集中抽象和归纳，</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >是范围绕企业的关键业务需求或分析目标而划分的特定范畴，</font> <font face=3D"宋体" >比如</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >电商和游戏行业</font>, 主题就像是一个“分析视角”， 会有用户、商品、订单、营销活动等主题 ;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(0,0,0);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >用户主题会集中存储与用户相关的所有数据</font>(比如注册信息、消费习惯、地域分布)等， 方便分析用户行为、用户画像等问题；&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >数据域：主要用于</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:宋体;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"宋体" >数据仓库</font></span></b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >的设计，特别是在</font>Kimball数仓建设和管理中，数据域划分是必须的过程, 一般就是把相同的业务过程集合。例如，常见的电商业务 数据域包括交易域、营销域、商品域、用户域等。</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >游戏业务</font>,&nbsp;数据域包括用户域、游戏行为域、虚拟经济域(金币、钻石各类游戏道具)、内容域、社交域等。</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >Q4. 主题域和数据域在数仓分层中如何体现?&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >这里我以</font>ods-&gt;dwd/dim-&gt;dws→ads 数仓分层架构来说</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >ODS &nbsp;=3D Operational Data Store &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;=3D 操作数据存储层（贴源层）</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >DWD &nbsp;=3D Data Warehouse Detail &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;=3D 数据仓库明细层</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >DIM &nbsp;=3D Dimension &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;=3D 维度层</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >DWS &nbsp;=3D Data Warehouse Service &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;=3D 数据仓库服务层（汇总层）</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.00