<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Confl=
uence">CREATE TABLE IF NOT EXISTS dwd_xxx_ug_event_pop_strategy_di
(
    stat_date     STRING COMMENT 'stat_date',
    local_time    STRING COMMENT 'local_time',
    user_id       STRING COMMENT 'user_id',
    utdid         STRING COMMENT 'utdid',
    os            STRING COMMENT '=E5=B9=B3=E5=8F=B0',
    os_version    STRING COMMENT '=E7=89=88=E6=9C=AC',
    event_id      STRING COMMENT 'event_id',
    sc_trackinfo  STRING COMMENT '=E5=9F=8B=E7=82=B9=E4=BF=A1=E6=81=AF',
    plan_id       STRING COMMENT '=E7=AD=96=E7=95=A5id',
    plan_name     STRING COMMENT '=E7=AD=96=E7=95=A5=E5=90=8D=E7=A7=B0',
    task_id       STRING COMMENT '=E4=BB=BB=E5=8A=A1id',
    biz_id        STRING COMMENT '=E4=B8=9A=E5=8A=A1id',
    biz_name      STRING COMMENT '=E4=B8=9A=E5=8A=A1=E5=90=8D=E7=A7=B0',
    template_id   STRING COMMENT '=E6=A8=A1=E7=89=88id',
    template_name STRING COMMENT '=E6=A8=A1=E7=89=88=E5=90=8D=E7=A7=B0',
    tag_union_id  STRING COMMENT 'tag_union_id',
    tag_name      STRING COMMENT '=E5=9D=91=E4=BD=8D=E5=90=8D=E7=A7=B0',
    scene_id      STRING COMMENT '=E5=9C=BA=E6=99=AFid',
    scene_name    STRING COMMENT '=E5=9C=BA=E6=99=AF',
    event_type    STRING COMMENT '=E7=94=A8=E6=88=B7=E8=A1=8C=E4=B8=BA=E7=
=B1=BB=E5=9E=8B:(exposure,click,close)',
    request_id    STRING COMMENT '=E8=AF=B7=E6=B1=82id',
    args          STRING COMMENT 'args',
    arg1          STRING COMMENT 'args1'
)=20
COMMENT '=E7=AD=96=E7=95=A5UT=E4=BA=8B=E4=BB=B6=E4=B8=8A=E6=8A=A5=E6=98=8E=
=E7=BB=86=E8=A1=A8'
PARTITIONED BY
(
    ds            STRING COMMENT 'ds',
    venture       STRING COMMENT 'venture'
)
;</pre>=20
</div>=20
</div>
