<div class=3D"codeContent panelContent pdl hide-toolbar">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Confl=
uence">CREATE TABLE IF NOT EXISTS dim_xxx_ug_strategy_allocation
(
    action_id            STRING COMMENT 'action id',
    has_lab_config       BIGINT COMMENT '=E6=98=AF=E5=90=A6=E9=85=8D=E7=BD=
=AE lab',
    has_user_target      BIGINT COMMENT '=E6=98=AF=E5=90=A6=E9=85=8D=E7=BD=
=AE =E4=BA=BA=E7=BE=A4',
    lab_config           STRING COMMENT 'lab =E9=85=8D=E7=BD=AE',
    task_id              BIGINT COMMENT 'task id',
    creator_id           STRING COMMENT 'creator id',
    creator_name         STRING COMMENT 'creator name',
    task_type            STRING COMMENT 'task type',
    plan_id              BIGINT COMMENT '=E7=AD=96=E7=95=A5id',
    plan_online_status   BIGINT COMMENT '=E6=8A=95=E6=94=BE=E8=AE=A1=E5=88=
=92=E7=BA=BF=E4=B8=8A=E7=8A=B6=E6=80=81',
    plan_name            STRING COMMENT '=E6=8A=95=E6=94=BE=E8=AE=A1=E5=88=
=92=E5=90=8D=E7=A7=B0',
    plan_time_valid_type STRING COMMENT '=E6=9C=89=E6=95=88=E6=97=B6=E9=97=
=B4=E7=B1=BB=E5=9E=8B: SPECIFIC_TIME/LONG_TERM',
    plan_begin_time      BIGINT COMMENT '=E6=9C=89=E6=95=88=E5=BC=80=E5=A7=
=8B=E6=97=B6=E9=97=B4',
    plan_end_time        BIGINT COMMENT '=E6=9C=89=E6=95=88=E7=BB=93=E6=9D=
=9F=E6=97=B6=E9=97=B4',
    campaign_id          BIGINT COMMENT '=E6=B4=BB=E5=8A=A8id',
    campaign_name        STRING COMMENT '=E6=B4=BB=E5=8A=A8=E5=90=8D=E7=A7=
=B0',
    valid_time_type      STRING COMMENT '=E6=B4=BB=E5=8A=A8=E6=97=B6=E9=97=
=B4=E7=B1=BB=E5=9E=8B',
    campaign_begin_time  BIGINT COMMENT '=E6=B4=BB=E5=8A=A8=E5=BC=80=E5=A7=
=8B=E6=97=B6=E9=97=B4',
    campaign_end_time    BIGINT COMMENT '=E6=B4=BB=E5=8A=A8=E7=BB=93=E6=9D=
=9F=E6=97=B6=E9=97=B4',
    biz_id               BIGINT COMMENT '=E4=B8=9A=E5=8A=A1id',
    biz_name             STRING COMMENT '=E4=B8=9A=E5=8A=A1=E5=90=8D=E7=A7=
=B0',
    template_id          BIGINT COMMENT '=E6=A8=A1=E6=9D=BFid',
    template_name        STRING COMMENT '=E6=A8=A1=E7=89=88=E5=90=8D=E7=A7=
=B0',
    channel_id           BIGINT COMMENT '=E6=B8=A0=E9=81=93id',
    channel_name         STRING COMMENT '=E6=B8=A0=E9=81=93=E5=90=8D=E7=A7=
=B0',
    tag_id               STRING COMMENT '=E5=9D=91=E4=BD=8Did',
    tag_union_id         BIGINT COMMENT '=E5=9D=91=E4=BD=8Dunion id',
    tag_name             STRING COMMENT '=E5=9D=91=E4=BD=8D=E5=90=8D=E7=A7=
=B0',
    venture              STRING COMMENT '=E5=9B=BD=E5=AE=B6'
)=20
COMMENT '=E7=AD=96=E7=95=A5=E4=B8=AD=E5=BF=83=E7=BB=B4=E5=BA=A6=E5=AE=BD=E8=
=A1=A8'
PARTITIONED BY
(
    ds                   STRING COMMENT '=E6=97=A5=E6=9C=9F=E5=88=86=E5=8C=
=BA'
)
;</pre>=20
</div>=20
</div>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">=20
<div class=3D"codeHeader panelHeader pdl hide-border-bottom">=20
<b class=3D"code-title"></b>=20
<span class=3D"collapse-source expand-control" style=3D"display:none;"><spa=
n class=3D"expand-control-icon icon">&nbsp;</span><span class=3D"expand-con=
trol-text">Expand source</span></span>=20
<span class=3D"collapse-spinner-wrapper"></span>=20
</div>=20
<div class=3D"codeContent panelContent pdl hide-toolbar">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Confl=
uence">INSERT OVERWRITE TABLE dwd_xx_ug_event_pop_strategy_di PARTITION (ds=
 =3D '${bizdate}',venture)
SELECT  /*+ MAPJOIN(t_strategy_info) */
        a.stat_date
        ,a.local_time
        ,a.user_id
        ,a.utdid
        ,a.os
        ,a.os_version
        ,a.event_id
        ,a.scTrackInfo AS sc_trackinfo
        ,COALESCE(GET_JSON_OBJECT(scTrackInfo,'$.strategyId'),t_strategy_in=
fo.plan_id) AS plan_id
        ,t_strategy_info.plan_name AS plan_name
        ,COALESCE(GET_JSON_OBJECT(a.scTrackInfo,'$.taskId'),t_strategy_info=
.task_id) AS task_id
        ,t_strategy_info.biz_id AS biz_id
        ,t_strategy_info.biz_name AS biz_name
        ,t_strategy_info.template_id AS template_id
        ,t_strategy_info.template_name AS template_name
        ,t_strategy_info.tag_union_id AS tag_union_id
        ,t_strategy_info.tag_name AS tag_name
        ,t_strategy_info.channel_id AS scene_id
        ,t_strategy_info.channel_name AS scene_name
        ,CASE   WHEN event_id IN ('2201','19999') THEN 'exposure'
                WHEN event_id IN ('2101')
                    AND (
                            KEYVALUE(args,',','=3D','behavior') IS NULL
                                OR KEYVALUE(args,',','=3D','behavior') !=3D=
 'close'
                )
                    AND (
                            KEYVALUE(URL_DECODE(KEYVALUE(args,',','=3D','go=
key')),'&amp;','=3D','behavior') IS NULL
                                OR KEYVALUE(URL_DECODE(KEYVALUE(args,',','=
=3D','gokey')),'&amp;','=3D','behavior') !=3D 'close'
                )
                    AND (
                            KEYVALUE(args,',','=3D','lifecycle') IS NULL
                                OR KEYVALUE(args,',','=3D','lifecycle') !=
=3D 'close_click'
                )
                    AND (
                            KEYVALUE(URL_DECODE(KEYVALUE(args,',','=3D','go=
key')),'&amp;','=3D','lifecycle') IS NULL
                                OR KEYVALUE(URL_DECODE(KEYVALUE(args,',','=
=3D','gokey')),'&amp;','=3D','lifecycle') !=3D 'close_click'
                ) THEN 'click'
                WHEN event_id IN ('2101')
                    AND (
                            KEYVALUE(args,',','=3D','behavior') =3D 'close'
                                OR KEYVALUE(URL_DECODE(KEYVALUE(args,',','=
=3D','gokey')),'&amp;','=3D','behavior') =3D 'close'
                                OR KEYVALUE(args,',','=3D','lifecycle') =3D=
 'close_click'
                                OR KEYVALUE(URL_DECODE(KEYVALUE(args,',','=
=3D','gokey')),'&amp;','=3D','lifecycle') =3D 'close_click'
                ) THEN 'close'
        END AS event_type
        ,GET_JSON_OBJECT(scTrackInfo,'$.requestId') AS request_id
        ,a.args
        ,a.arg1
        ,a.venture
FROM    (
            SELECT  venture
                    ,stat_date
                    ,local_time
                    ,user_id
                    ,utdid
                    ,os
                    ,os_version
                    ,event_id
                    ,COALESCE(URL_DECODE(KEYVALUE(args,',','=3D','scTrackIn=
fo')),KEYVALUE(URL_DECODE(KEYVALUE(args,',','=3D','gokey')),'&amp;','=3D','=
scTrackInfo')) AS scTrackInfo
                    ,args
                    ,arg1
            FROM    alilog.dwd_lzd_user_track
            WHERE   ds =3D '${bizdate}'
            AND     venture IN ('TH','MY','ID','SG','VN','PH')
            AND     event_id IN ('2201','2101','19999') --=E5=9B=BE=E7=89=
=87=E5=BC=B9=E7=AA=97=E6=9B=9D=E5=85=89=E5=9F=8B=E7=82=B9=E4=B8=BA19999
            AND     event_type IN ('cntrl','exposure','self_define')
            AND     COALESCE(URL_DECODE(KEYVALUE(args,',','=3D','scTrackInf=
o')),KEYVALUE(URL_DECODE(KEYVALUE(args,',','=3D','gokey')),'&amp;','=3D','s=
cTrackInfo')) IS NOT NULL
        ) a
LEFT JOIN   (
                SELECT  DISTINCT plan_id
                        ,plan_name
                        ,task_id
                        ,channel_id
                        ,channel_name
                        ,biz_id
                        ,biz_name
                        ,template_id
                        ,template_name
                        ,tag_union_id
                        ,tag_name
                        ,venture
                FROM    xxx_mkt.dim_lzd_ug_strategy_allocation
                WHERE   ds =3D MAX_PT('xxx_mkt.dim_lzd_ug_strategy_allocati=
on')
                -- AND     tag_union_id IN (143821111201,161922110301,11072=
2102001,215322053101)
            ) t_strategy_info
ON      GET_JSON_OBJECT(a.scTrackInfo,'$.taskId') =3D t_strategy_info.task_=
id
AND     t_strategy_info.venture =3D a.venture
;</pre>=20
</div>=20
</div>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">=20
<div class=3D"codeHeader panelHeader pdl hide-border-bottom">=20
<b class=3D"code-title"></b>=20
<span class=3D"collapse-source expand-control" style=3D"display:none;"><spa=
n class=3D"expand-control-icon icon">&nbsp;</span><span class=3D"expand-con=
trol-text">Expand source</span></span>=20
<span class=3D"collapse-spinner-wrapper"></span>=20
</div>=20
<div class=3D"codeContent panelContent pdl hide-toolbar">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence; collapse: true" data-theme=3D"Confl=
uence">INSERT OVERWRITE TABLE dim_xxx_ug_strategy_allocation PARTITION(ds=
=3D '${bizdate}')
SELECT  t_action.id AS action_id
        ,t_action.has_lab_config
        ,t_action.has_user_target
        ,t_action.lab_config
        ,t_task.id AS task_id
        ,t_task.creator_id
        ,URL_DECODE(t_task.creator_name) AS creator_name
        ,t_task.task_type
        ,t_plan.id AS plan_id
        ,t_plan.online_status AS plan_online_status
        ,t_plan.name AS plan_name
        ,t_plan.plan_valid_time_type AS plan_time_valid_type
        ,t_plan.valid_time_begin AS plan_begin_time
        ,t_plan.valid_time_end AS plan_end_time
        ,t_campaign.id AS campaign_id
        ,t_campaign.name AS campaign_name
        ,t_campaign.valid_time_type AS campaign_valid_time
        ,t_campaign.valid_time_begin AS campaign_begin_time
        ,t_campaign.valid_time_end AS campaign_end_time
        ,t_biz.id AS biz_id
        ,t_biz.name AS biz_name=20
        -- ,t_content.content_config as content_config
        ,t_template.id AS template_id
        ,t_template.name AS template_name
        ,t_task_scene.channel_id
        ,t_channel.channel_name
        ,t_task_scene.tag_id AS tag_id
        ,t_tag.tag_union_id AS tag_union_id
        ,t_tag.tag_name AS tag_name
        ,t_task_scene.venture=20
FROM    (
            SELECT =20
                    id
                    ,has_lab_config
                    ,has_user_target
                    ,lab_config
            FROM    xxx_tech.s_allocation_action_xxx_ug_stars_sg_app
            WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_action_xxx_ug_star=
s_sg_app')
            AND     venture IN ('ID','TH','VN','SG','PH','MY')
            AND     deleted =3D 0
        ) t_action
INNER JOIN  (
                SELECT  -- =E7=9B=AE=E5=89=8D=E6=B2=A1=E6=9C=89=E9=87=8D=E5=
=A4=8D=E7=9A=84=E6=83=85=E5=86=B5
                        id
                        ,creator_id
                        ,creator_name
                        ,task_type
                        ,plan_id=20
                FROM    xxx_tech.s_allocation_task_xxx_ug_stars_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_task_xxx_ug_st=
ars_sg_app')
                AND     venture IN ('ID','TH','VN','SG','PH','MY')
                AND     deleted =3D 0 -- AND id =3D 2708484096
            ) t_task
ON      t_task.id =3D t_action.task_id
INNER JOIN  (
                SELECT  -- =E7=9B=AE=E5=89=8D=E6=B2=A1=E6=9C=89=E9=87=8D=E5=
=A4=8D=E7=9A=84=E6=83=85=E5=86=B5=20
                        task_id
                        ,channel_id
                        ,tag_id=20
                        ,venture
                FROM    xxx_tech.s_allocation_task_scene_xxx_ug_stars_sg_ap=
p
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_task_scene_xxx=
_ug_stars_sg_app')
                AND     deleted =3D 0
                AND     venture IN ('ID','TH','VN','SG','PH','MY')
                GROUP BY task_id
                         ,channel_id
                         ,tag_id=20
                         ,venture
            ) t_task_scene
ON      t_task_scene.task_id =3D t_task.id
INNER JOIN  (
                SELECT   -- plan_id,plan_name =E5=85=A8=E5=B1=80=E5=94=AF=
=E4=B8=80=20
                        id=20
                        ,online_status
                        ,name=20
                        ,plan_valid_time_type
                        ,valid_time_begin=20
                        ,valid_time_end=20
                FROM    xxx_tech.s_allocation_plan_xxx_ug_stars_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_plan_xxx_ug_st=
ars_sg_app')
                -- AND     online_status =3D 'RUNNING'
                AND     deleted =3D 0
            ) t_plan
ON      t_plan.id =3D t_task.plan_id
INNER JOIN  (
                SELECT =20
                        id=20
                        ,name=20
                        ,valid_time_type
                        ,valid_time_begin=20
                        ,valid_time_end=20
                FROM    xxx_tech.s_allocation_campaign_xxx_ug_stars_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_campaign_xxx_u=
g_stars_sg_app')
                AND     deleted =3D 0 -- AND id =3D 606003200
            ) t_campaign
ON      t_campaign.id =3D t_plan.campaign_id
INNER JOIN  (
                SELECT  id
                        ,name -- =E5=85=AD=E4=B8=AA=E5=9B=BD=E5=AE=B6=E4=B8=
=8D=E5=90=8C=E7=9A=84biz=20
                        ,venture
                FROM    xxx_tech.s_allocation_biz_xxx_ug_stars_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_biz_xxx_ug_sta=
rs_sg_app')
                AND     env =3D 'PRD'
                AND     deleted =3D 0
            ) t_biz
ON      t_biz.id =3D t_campaign.biz_id
INNER JOIN  (
                SELECT  content_template_id
                        ,action_id -- =E5=8F=AF=E8=83=BD=E6=9B=B4=E6=96=B0=
=E5=86=85=E5=AE=B9=E9=85=8D=E7=BD=AE,=E5=B9=B6=E4=B8=94=E8=BF=98=E4=BF=9D=
=E7=95=99=E4=BA=86 (=E9=9C=80=E8=A6=81=E5=8E=BB=E9=87=8D)
                FROM    xxx_tech.s_allocation_content_xxx_ug_stars_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_content_xxx_ug=
_stars_sg_app')
                AND     deleted =3D 0 -- AND action_id =3D 4192110080
                GROUP BY content_template_id,action_id
            ) t_content
ON      t_content.action_id =3D t_action.id
INNER JOIN  (
                SELECT  id
                        ,name -- =E5=86=85=E5=AE=B9=E6=A8=A1=E6=9D=BF =E5=
=94=AF=E4=B8=80(=E4=B8=8D=E9=9C=80=E8=A6=81=E5=8E=BB=E9=87=8D)
                FROM    xxx_tech.s_allocation_content_template_xxx_ug_stars=
_sg_app
                WHERE   ds =3D MAX_PT('xxx_tech.s_allocation_content_templa=
te_xxx_ug_stars_sg_app')
                AND     env =3D 'PRD'
                AND     deleted =3D 0
            ) t_template
ON      t_content.content_template_id =3D t_template.id
LEFT JOIN   (
                SELECT  tag_union_id
                        ,tag_id=20
                        ,tag_name
                FROM    xxx_tech.lzd_ug_stars_sg_s_stars_channel_tag_new
                WHERE   ds =3D MAX_PT('xxx_tech.lzd_ug_stars_sg_s_stars_cha=
nnel_tag_new')
                AND     env =3D 'PRD'
                AND     TOUPPER(tag_name) NOT LIKE 'GCP_%'
                AND     venture IN ('ID','TH','VN','SG','PH','MY')
                AND     delete_flag =3D 0
            ) t_tag
ON      t_tag.id =3D t_task_scene.tag_id
LEFT JOIN   (
                SELECT  id
                        ,channel_name
                FROM    xxx_tech.lzd_ug_stars_sg_s_stars_channel_new
                WHERE   ds =3D MAX_PT('xxx_tech.lzd_ug_stars_sg_s_stars_cha=
nnel_new')
                AND     venture =3D 'ALL'
                AND     env =3D 'PRD'
                AND     TOLOWER(channel_name) NOT LIKE '%test%'
                AND     delete_flag =3D 0
            ) t_channel
ON      t_channel.id =3D t_task_scene.channel_id=20
;</pre>=20
