<p style=3D"text-align: left;">=E4=BB=A3=E7=A0=81=E5=AE=9E=E7=8E=B0</p>
<p style=3D"text-align: left;">=E6=95=B0=E6=8D=AE=E6=BA=90=E8=AF=B4=E6=98=
=8E:&nbsp;</p>
<ul>
<li style=3D"text-align: left;">ds_cdm.dwd_ds_trd_core_di: =E8=AE=A2=E5=8D=
=95=E8=A1=A8</li>
<li style=3D"text-align: left;">ds_cdm.dim_ds_prd_sku_core: =E5=95=86=E5=93=
=81=E7=BB=B4=E5=BA=A6=E8=A1=A8(venture + sku_id=E7=B2=92=E5=BA=A6)</li>
<li style=3D"text-align: left;">ds_mkt.dwd_ds_ug_promotion_redeem_di: =E5=
=88=B8=E6=A0=B8=E9=94=80=E8=A1=A8</li>
<li style=3D"text-align: left;">ds_mkt.dim_ds_ug_promotion: =E5=88=B8=E7=BB=
=B4=E5=BA=A6=E8=A1=A8</li>
<li style=3D"text-align: left;">ds_cdm.dim_ds_prd_product:&nbsp;=E5=95=86=
=E5=93=81=E7=BB=B4=E5=BA=A6=E8=A1=A8(venture + product_id=E7=B2=92=E5=BA=A6=
)</li>
<li style=3D"text-align: left;">ds_cdm.dim_ds_prd_global_category: =E8=A1=
=8C=E4=B8=9A=E7=BB=B4=E5=BA=A6=E8=A1=A8</li>
<li style=3D"text-align: left;">dslog.dwd_ds_log_ut_pv_di : =E7=94=A8=E6=88=
=B7=E5=95=86=E5=93=81=E9=A1=B5=E9=9D=A2=E8=AE=BF=E9=97=AE=E6=97=A5=E5=BF=97=
;</li>
</ul>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">--* =E8=
=AE=A2=E5=8D=95=E6=98=8E=E7=BB=86 * --
WITH tmp_trd_promotion AS (
SELECT=20
        t_order.buyer_id
        ,t_order.venture
        ,t_order.check_out_id
        ,t_order.sales_order_item_id
        ,t_order.sales_order_id
        ,t_order.sku_id
        ,t_order.product_id
        ,IF(t_pro_item.promotion_id is null,0,1) as use_promo
        ,COALESCE(t_pro_item.promotion_amount_usd,0) AS promotion_amount
        ,t_pro_item.actual_gmv_usd
        ,t_pro_dim.product_code
        ,t_pro_dim.product_sub_code
        ,COALESCE(t_pro_item.scene_id,'unknown') AS scene_id
        ,COALESCE(t_pro_item.scene_name,'unknown') AS scene_name
FROM
        (
        SELECT =20
                venture=20
                ,CASE WHEN  client_type IN  ('iosApp','androidApp') THEN  '=
APP'=20
                ELSE  'WEB'  END  AS  platform
                ,sales_order_item_id
                ,sales_order_id
                ,check_out_id
                ,actual_gmv
                ,exchange_rate
                ,sku_id
                ,product_id
                ,buyer_id
                -- ,actual_gmv * exchange_rate as actual_gmv_order_usd
        FROM    ds_cdm.dwd_ds_trd_core_di
        WHERE   ds =3D '${bizdate}'
        AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
        AND     is_revenue =3D 1
        AND     fulfillment_create_date IS NOT NULL
        AND     COALESCE(business_application,'') !=3D 'ZAL'
        AND     COALESCE(regional_category_key,'') &lt;&gt; '160800000000' =
   -- =E5=8E=BB=E6=8E=89Gift card=E5=95=86=E5=93=81
        AND     buyer_id IS NOT NULL
        ) t_order=20
LEFT  JOIN=20
        (
        SELECT *
        FROM ds_cdm.dim_ds_prd_sku_core=20
        WHERE ds =3D MAX_PT('ds_cdm.dim_ds_prd_sku_core')
        AND   venture IN ( 'SG','TH','PH','ID','VN','MY')
        AND sku_status =3D 1
        AND is_visible =3D 1
        ) t_all_sku
ON t_all_sku.venture =3D t_order.venture
AND t_all_sku.sku_id =3D t_order.sku_id=20
AND t_all_sku.product_id =3D t_order.product_id
LEFT JOIN=20
        (
        SELECT *
        FROM ds_mkt.dwd_ds_ug_promotion_redeem_di =20
        WHERE ds =3D '${bizdate}'
        AND  venture IN ( 'SG','TH','PH','ID','VN','MY')
        ) t_pro_item=20
ON t_order.sales_order_item_id =3D t_pro_item.sales_order_item_id
AND t_order.venture =3D t_pro_item.venture
LEFT JOIN=20
        (
        SELECT *      =20
        FROM ds_mkt.dim_ds_ug_promotion=20
        WHERE ds =3D MAX_PT('ds_mkt.dim_ds_ug_promotion')
        AND   venture IN ( 'SG','TH','PH','ID','VN','MY')
        ) t_pro_dim=20
ON t_pro_item.promotion_id =3D t_pro_dim.promotion_id=20
AND t_pro_item.venture =3D t_pro_dim.venture=20
),

tmp_product_with_array AS (
SELECT=20
    t.venture
    ,t.product_id
    ,ARRAY(
            '0'
            ,tmp_dim_cate.industry_id
            ,tmp_dim_cate.regional_category1_id
            ,tmp_dim_cate.regional_category2_id
            ,tmp_dim_cate.regional_category3_id
        ) AS cate_ids =20
FROM=20
(
        SELECT  venture
                ,product_id
        FROM    ds_cdm.dim_ds_prd_product=20
        WHERE  ds=3DMAX_PT('ds_cdm.dim_ds_prd_product')=20
        AND    venture IN ( 'SG','TH','PH','ID','VN','MY')
)  t--* =E5=95=86=E5=93=81=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  venture
                            ,product_id
                            ,brand_id
                            ,regional_category_key
                            ,seller_id
                            ,bu_id
                    FROM    ds_cdm.dim_ds_prd_product
                    WHERE   ds =3D MAX_PT('ds_cdm.dim_ds_prd_product')=20
                    AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
                ) tmp_dim_prd
ON      t.venture =3D tmp_dim_prd.venture
AND     t.product_id =3D tmp_dim_prd.product_id
--* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  industry_id
                            ,`regional_category.*`
                    FROM    ds_cdm.dim_ds_prd_global_category
                    WHERE   ds =3D '${bizdate}'
                ) tmp_dim_cate
ON      tmp_dim_prd.regional_category_key =3D tmp_dim_cate.regional_categor=
y_key
),

tmp_order_with_array AS (
SELECT=20
    t.venture
    ,t.product_id
    ,t.buyer_id
    ,t.actual_gmv_usd=20
    ,t.check_out_id
    ,ARRAY(
            '0'
            ,tmp_dim_cate.industry_id
            ,tmp_dim_cate.regional_category1_id
            ,tmp_dim_cate.regional_category2_id
            ,tmp_dim_cate.regional_category3_id
        ) AS cate_ids =20
FROM=20
(
       SELECT =20
                venture=20
                ,product_id
                ,buyer_id
                ,check_out_id
                ,SUM(actual_gmv * exchange_rate) as actual_gmv_usd
        FROM    ds_cdm.dwd_ds_trd_core_di
        WHERE   ds =3D '${bizdate}'
        AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
        AND     is_revenue =3D 1
        AND     fulfillment_create_date IS NOT NULL
        AND     COALESCE(business_application,'') !=3D 'ZAL'
        AND     COALESCE(regional_category_key,'') &lt;&gt; '160800000000' =
   -- =E5=8E=BB=E6=8E=89Gift card=E5=95=86=E5=93=81
        AND     buyer_id IS NOT NULL
        GROUP BY venture=20
                ,product_id
                ,buyer_id
                ,check_out_id
) t--* =E5=95=86=E5=93=81=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  venture
                            ,product_id
                            ,brand_id
                            ,regional_category_key
                            ,seller_id
                            ,bu_id
                    FROM    ds_cdm.dim_ds_prd_product
                    WHERE   ds =3D MAX_PT('ds_cdm.dim_ds_prd_product')=20
                    AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
                ) tmp_dim_prd
ON      t.venture =3D tmp_dim_prd.venture
AND     t.product_id =3D tmp_dim_prd.product_id
--* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  industry_id
                            ,`regional_category.*`
                    FROM    ds_cdm.dim_ds_prd_global_category
                    WHERE   ds =3D '${bizdate}'
                ) tmp_dim_cate
ON      tmp_dim_prd.regional_category_key =3D tmp_dim_cate.regional_categor=
y_key
),

--* =E7=94=A8=E6=9D=83=E7=9B=8A=E7=9A=84=E6=8C=87=E6=A0=87,=E5=85=B3=E8=81=
=94=E7=BB=B4=E8=A1=A8, =E6=8B=BC=E4=B8=8AID=E4=B8=B2, =E4=BB=A5=E4=BE=BF=E4=
=BA=8E=E5=90=8E=E7=BB=AD cube =E6=9E=84=E5=BB=BA *--=20
tmp_pro_with_array AS (
    SELECT=20
        /*+MAPJOIN(tmp_dim_cate,tmp_dim_bu)*/
            t.venture
            ,t.product_code
            ,t.product_sub_code
            ,t.scene_id=20
            ,t.scene_name
            ,t.product_id
            ,t.buyer_id
            ,t.pay_ord
            ,t.guide_gmv
            ,t.pay_qty
            ,ARRAY(
                '0'
                ,tmp_dim_cate.industry_id
                ,tmp_dim_cate.regional_category1_id
                ,tmp_dim_cate.regional_category2_id
                ,tmp_dim_cate.regional_category3_id
            ) AS cate_ids    -- =E7=B1=BB=E7=9B=AEID=E4=B8=B2
    FROM    (=20
                SELECT=20
                        product_code
                        ,product_sub_code
                        ,scene_id
                        ,scene_name
                        ,product_id
                        ,venture
                        ,buyer_id
                        ,SUM( SPLIT_PART(gmv.sales_order_it,'#',2) ) guide_=
gmv
                        ,MAX(pay_ord) AS pay_ord
                        ,MAX(pay_qty) AS pay_qty
                FROM
                (
                        SELECT=20
                        IF(GROUPING(product_code) =3D 0 ,product_code,'ALL'=
) AS product_code
                        ,IF(GROUPING(product_sub_code) =3D0 ,product_sub_co=
de,'ALL') AS product_sub_code
                        ,IF(GROUPING(scene_id) =3D0 ,scene_id,'ALL') AS sce=
ne_id
                        ,IF(GROUPING(scene_name) =3D0 ,scene_name,'ALL') AS=
 scene_name
                        ,product_id
                        ,venture
                        ,buyer_id
                        ,COLLECT_SET(
                                        concat(sales_order_item_id,'#',actu=
al_gmv_usd)
                        ) sales_order_item_id_set
                        ,COUNT(DISTINCT check_out_id) AS  pay_ord -- =E7=88=
=B6=E8=AE=A2=E5=8D=95=E6=95=B0
                        ,COUNT(DISTINCT sales_order_item_id) AS  pay_qty --=
 =E5=95=86=E5=93=81=E4=BB=B6=E6=95=B0 =20
                        FROM  tmp_trd_promotion=20
                        WHERE use_promo =3D 1
                        GROUP BY ROLLUP(product_code,product_sub_code)
                        ,ROLLUP((scene_id,scene_name))
                        ,product_id,venture,buyer_id
                ) res=20
                LATERAL VIEW explode(sales_order_item_id_set) gmv AS sales_=
order_it
                GROUP BY product_code
                        ,product_sub_code
                        ,scene_id
                        ,scene_name
                        ,product_id
                        ,venture
                        ,buyer_id
            ) t
--* =E5=95=86=E5=93=81=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  venture
                            ,product_id
                            ,brand_id
                            ,regional_category_key
                            ,seller_id
                            ,bu_id
                    FROM    ds_cdm.dim_ds_prd_product
                    WHERE   ds =3D '${bizdate}'
                ) tmp_dim_prd
ON      t.venture =3D tmp_dim_prd.venture
AND     t.product_id =3D tmp_dim_prd.product_id
--* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  industry_id
                            ,`regional_category.*`
                    FROM    ds_cdm.dim_ds_prd_global_category
                    WHERE   ds =3D '${bizdate}'
                ) tmp_dim_cate
ON      tmp_dim_prd.regional_category_key =3D tmp_dim_cate.regional_categor=
y_key
),
-- *ipv * --
tmp_ipv_with_array as (
SELECT=20
    t.venture
    ,t.product_id
    ,t.utdid
    ,t.ipv
    ,ARRAY(
            '0'
            ,tmp_dim_cate.industry_id
            ,tmp_dim_cate.regional_category1_id
            ,tmp_dim_cate.regional_category2_id
            ,tmp_dim_cate.regional_category3_id
        ) AS cate_ids =20
FROM=20
(
        select  venture
                ,utdid
                ,asc_item_id as product_id
                ,count(1) as ipv
        from    dslog.dwd_ds_log_ut_pv_di
        where   ds =3D '${bizdate}'
        AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
        AND     url_type =3D 'ipv'
        AND     COALESCE(asc_item_id,'') &lt;&gt; ''=20
        GROUP BY venture
                ,utdid
                ,asc_item_id=20
)  t--* =E5=95=86=E5=93=81=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  venture
                            ,product_id
                            ,brand_id
                            ,regional_category_key
                            ,seller_id
                            ,bu_id
                    FROM    ds_cdm.dim_ds_prd_product
                    WHERE   ds =3D MAX_PT('ds_cdm.dim_ds_prd_product')=20
                    AND     venture IN ( 'SG','TH','PH','ID','VN','MY')
                ) tmp_dim_prd
ON      t.venture =3D tmp_dim_prd.venture
AND     t.product_id =3D tmp_dim_prd.product_id
--* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 * --
LEFT OUTER JOIN (
                    SELECT  industry_id
                            ,`regional_category.*`
                    FROM    ds_cdm.dim_ds_prd_global_category
                    WHERE   ds =3D '${bizdate}'
                ) tmp_dim_cate
ON      tmp_dim_prd.regional_category_key =3D tmp_dim_cate.regional_categor=
y_key
),

--* =E6=9D=83=E7=9B=8A=E7=B1=BB=E6=8C=87=E6=A0=87 *--
tmp_cube_0 AS (
SELECT /*+ MAPJOIN(tmp_dim_cate)*/
            '${bizdate}' AS stat_date
            ,tmp_agg.venture
            ,tmp_agg.product_code
            ,tmp_agg.product_sub_code
            ,tmp_agg.scene_id
            ,tmp_agg.scene_name
            --* =E7=B1=BB=E7=9B=AE=E7=BB=B4=E5=BA=A6 *--=20
            ,tmp_agg.cate_id
            ,tmp_dim_cate.regional_category_name            AS cate_name
            ,NVL(tmp_dim_cate.regional_category_level, -99) AS cate_level
            ,NVL(tmp_dim_cate.parent_cate_id, '-99')        AS parent_cate_=
id
            ,tmp_dim_cate.parent_cate_name
            --* =E6=8C=87=E6=A0=87*--
            ,tmp_agg.pro_guide_gmv
            ,tmp_agg.pro_pay_uv
            ,tmp_agg.pro_pay_ord
            ,tmp_agg.pro_pay_qty
            ,tmp_agg.pro_pay_itm_cnt
            ,ROUND(tmp_agg.pro_guide_gmv/pro_pay_itm_cnt, 4)        AS avg_=
pro_guide_gmv
            ,ROUND(tmp_agg.pro_pay_uv/pro_pay_itm_cnt, 4)           AS avg_=
pro_pay_uv
            ,ROUND(tmp_agg.pro_pay_qty/pro_pay_itm_cnt, 4)          AS avg_=
pro_pay_itm_cnt
    FROM    (
                SELECT  IF(GROUPING(t.venture) =3D 0 ,t.venture,'SEA') AS v=
enture
                        ,t.product_code
                        ,t.product_sub_code
                        ,t.scene_name
                        ,t.scene_id
                        ,v1.cate_id
                        ,SUM(guide_gmv)                     AS pro_guide_gm=
v
                        ,COUNT(DISTINCT t.buyer_id)         AS pro_pay_uv
                        ,SUM(pay_ord)                       AS pro_pay_ord
                        ,SUM(pay_qty)                       AS pro_pay_qty
                        ,COUNT(DISTINCT t.product_id)       AS pro_pay_itm_=
cnt
                --* =E6=98=8E=E7=BB=86 *--
                FROM    tmp_pro_with_array t
                --* =E7=94=9F=E6=88=90 cube *--
                LATERAL VIEW EXPLODE(cate_ids) v1        AS cate_id
                --* =E5=89=94=E9=99=A4=E5=BC=82=E5=B8=B8=E5=80=BC *--
                WHERE   NVL(v1.cate_id,'') &lt;&gt; ''
                GROUP BY t.venture
                         ,t.product_code
                         ,t.product_sub_code
                         ,t.scene_id
                         ,t.scene_name
                         ,v1.cate_id
                GROUPING SETS ((t.venture
                         ,t.product_code
                         ,t.product_sub_code
                         ,t.scene_id=20
                         ,t.scene_name
                         ,v1.cate_id),
                         (t.product_code
                         ,t.product_sub_code
                         ,t.scene_id=20
                         ,t.scene_name
                         ,v1.cate_id))
            ) tmp_agg
    --* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 *--
    LEFT OUTER JOIN (
                        SELECT  regional_category_key
                                ,regional_category_name
                                ,regional_category_level
                                ,parent_cate_id
                                ,parent_cate_name
                        FROM    ds_cdm.dim_ds_prd_global_category
                        WHERE   ds =3D '${bizdate}'
                    ) tmp_dim_cate
    ON      tmp_agg.cate_id =3D tmp_dim_cate.regional_category_key
),
--* =E5=95=86=E5=93=81=E6=B1=A0=E6=8C=87=E6=A0=87 *--=20
tmp_cube_1 AS (
    SELECT /*+ MAPJOIN(tmp_dim_cate)*/
            '${bizdate}' AS stat_date
            ,tmp_agg.venture
            --* =E7=B1=BB=E7=9B=AE=E7=BB=B4=E5=BA=A6 *--=20
            ,tmp_agg.cate_id
            ,tmp_dim_cate.regional_category_name            AS cate_name
            ,NVL(tmp_dim_cate.regional_category_level, -99) AS cate_level
            ,NVL(tmp_dim_cate.parent_cate_id, '-99')        AS parent_cate_=
id
            ,tmp_dim_cate.parent_cate_name
            --* =E6=8C=87=E6=A0=87 * --
            ,tmp_agg.all_itm_cnt
    FROM (       =20
                SELECT  IF(GROUPING(t.venture) =3D 0 ,t.venture,'SEA') AS v=
enture
                        ,v1.cate_id
                        ,COUNT(DISTINCT t.product_id)       AS all_itm_cnt
                --* =E6=98=8E=E7=BB=86 *--
                FROM    tmp_product_with_array t
                --* =E7=94=9F=E6=88=90 cube *--
                LATERAL VIEW EXPLODE(cate_ids) v1        AS cate_id
                --* =E5=89=94=E9=99=A4=E5=BC=82=E5=B8=B8=E5=80=BC *--
                WHERE   NVL(v1.cate_id,'') &lt;&gt; ''
                GROUP BY t.venture
                        ,v1.cate_id
                GROUPING SETS (
                    (t.venture
                        ,v1.cate_id),(v1.cate_id)
                )

        ) tmp_agg=20
    --* =E8=A1=8C=E4=B8=9A=E7=B1=BB=E7=9B=AE=E7=BB=B4=E8=A1=A8 *--
    LEFT OUTER JOIN (
                        SELECT  regional_category_key
                                ,regional_category_name
                                ,regional_category_level
                                ,parent_cate_id
                                ,parent_cate_name
                        FROM    ds_cdm.dim_ds_prd_global_category
                        WHERE   ds =3D '${bizdate}'
                    ) tmp_dim_cate
    ON      tmp_agg.cate_id =3D tmp_dim_cate.regional_category_key         =
   =20
),

</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>BI =E5=B7=A5=E5=85=B7=E9=85=8D=E7=BD=
=AE=E7=9A=84=E6=95=B0=E6=8D=AE=E9=9B=86</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">#set($cat=
e_param =3D $cate_param.replace('ALL', '0'))
SELECT
  stat_date,
  venture,
  cate_id,
  cate_name,
  cate_level,
  Case when cate_id =3D '${cate_param}' THEN 'root' ELSE parent_cate_id END=
  as parent_cate_id,
  parent_cate_name,
  product_code,
  product_sub_code,
  scene_id,
  scene_name,
  pro_guide_gmv,
  pro_pay_uv,
  pro_pay_ord,
  pro_pay_qty,
  pro_pay_itm_cnt,
  avg_pro_guide_gmv,
  avg_pro_pay_uv,
  avg_pro_pay_itm_cnt,
  all_itm_cnt,
  pay_itm_cnt,
  pay_ord,
  pay_uv,
  actual_gmv_usd,
  pay_item_rate,
  ipv,
  ipv_uv
 FROM ds_mkt.dws_ds_ug_pro_product_di
 WHERE stat_date=3D'${ds_param}'
#if(${cate_param}=3D=3D'0')
AND cate_id &lt;&gt; '-9999'
#elseif((${cate_param} =3D=3D '10001') or (${cate_param} =3D=3D'10002') or =
(${cate_param} =3D=3D'10003') or (${cate_param} =3D=3D'10004') or (${cate_p=
aram} =3D=3D'10005') or (${cate_param} =3D=3D'10010'))=20
AND cate_level &gt;=3D 0
#elseif((${parent_cate_param} =3D=3D '10001') or (${parent_cate_param} =3D=
=3D'10002') or (${parent_cate_param} =3D=3D'10003') or (${parent_cate_param=
} =3D=3D'10004') or (${parent_cate_param} =3D=3D'10005') or (${parent_cate_=
param} =3D=3D'10010'))=20
AND cate_level &gt;=3D 1
#else=20
AND (cate_id=3D'${cate_param}' or parent_cate_id=3D '${cate_param}' )
#end
;</pre>=20
</div>
</div>
<p style=3D"text-align: left;"><span>=E6=8A=A5=E8=A1=A8=E5=B7=A5=E5=85=B7=
