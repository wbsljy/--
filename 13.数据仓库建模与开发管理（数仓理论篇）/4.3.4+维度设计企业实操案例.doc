=E4=B8=BB=E7=BB=B4=E5=BA=A6=E8=A1=A8=E4=B8=BA=EF=BC=9A=E8=B4=A7=E5=93=81=E8=
=A1=A8s_trunk_auction_auctions</span><br><span>3.=E7=A1=AE=E5=AE=9A=E7=9B=
=B8=E5=85=B3=E7=BB=B4=E5=BA=A6=EF=BC=9A</span></p>
<ul>
<li style=3D"text-align: left;"><span>=E5=8F=96=E7=B1=BB=E7=9B=AE=EF=BC=9Ad=
im_ds_prd_category_tree_local</span></li>
<li style=3D"text-align: left;"><span>=E5=8F=96=E5=95=86=E5=93=81=E5=9B=BE=
=E7=89=87=E4=BF=A1=E6=81=AF=EF=BC=9Adim_ds_prd_product_image</span><span>=
=E7=AD=89</span></li>
<li style=3D"text-align: left;"><span>=E5=85=B6=E4=BB=96=E7=9B=B8=E5=85=B3=
=E7=BB=B4=E5=BA=A6=E8=A1=A8=EF=BC=9Axxxx</span></li>
</ul>
<p style=3D"text-align: left;"><span>4.=E9=80=89=E6=8B=A9=E7=BB=B4=E5=BA=A6=
=E5=B1=9E=E6=80=A7=EF=BC=9A=E4=BB=8E=E4=B8=BB=E7=BB=B4=E8=A1=A8=E4=B8=AD=E9=
=80=89=E6=8B=A9=E5=95=86=E5=93=81=E5=9F=BA=E6=9C=AC=E4=BF=A1=E6=81=AF=E7=AD=
=89=E5=B1=9E=E6=80=A7=EF=BC=8C=E5=86=8D=E4=BB=8E=E7=9B=B8=E5=85=B3=E7=BB=B4=
=E5=BA=A6=E8=A1=A8=E4=B8=AD=E9=80=89=E6=8B=A9=E4=BA=86=E5=9B=BE=E7=89=87=E3=
=80=81=E7=B1=BB=E7=9B=AE=E7=AD=89=E5=B1=9E=E6=80=A7=E3=80=82</span></p>
<p style=3D"text-align: left;"><span>=E4=BB=A3=E7=A0=81=E5=AE=9E=E7=8E=B0:&=
nbsp;</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">insert ov=
erwrite table tmp_dim_ds_prd_product_01 partition(ds =3D '${bizdate}',ventu=
re=3D'@@{venture}')
select  trunk_aa.auction_id as auction_id
        ,coalesce(
            keyvalue(trunk_aa.features,'sub_seller_id')
            ,trunk_aa.seller_id
        ) as seller_id
        ,trunk_aa.admin_user_id as admin_user_id
        ,trunk_aa.title as title
        ,trunk_aa.sub_title as sub_title
        ,trunk_aa.pict_url as pict_url
        ,trunk_aa.top_category as top_category
        ,trunk_aa.category as category
        ,trunk_aa.brand_id as brand_id
        ,trunk_aa.spu_id as spu_id
        ,trunk_aa.attributes as attributes
        ,trunk_aa.features as features
        ,trunk_aa.feature_cc as feature_cc
        ,trunk_aa.user_type as user_type
        ,trunk_aa.auction_status as auction_status
        ,trunk_aa.approve_status as approve_status
        ,trunk_aa.sub_status as sub_status
        ,trunk_aa.stuff_status as stuff_status
        ,trunk_aa.approve_user_id as approve_user_id
        ,trunk_aa.desc_path as desc_path
        ,trunk_aa.gmt_modified as gmt_modified
        ,trunk_aa.gmt_create as gmt_create
        ,trunk_aa.gmt_approve as gmt_approve
        ,trunk_aa.last_modified as last_modified
        ,trunk_aa.postage_id as postage_id
        ,trunk_aa.sync_version as sync_version
        ,trunk_aa.options as options
        ,trunk_aa.change_field as change_field
        ,trunk_aa.item_dim as item_dim
        ,trunk_aa.return_policy as return_policy
        ,trunk_aa.seller_id as parent_seller_id
        ,trunk_aa.gmt_create as first_gmt_create
        ,REPLACE(
            KEYVALUE(trunk_aa.features,';',':','write_trunk_date')
            ,'#3B'
            ,':'
        ) as write_trunk_date
        ,trunk_aa.original_currency_code as currency_code
        ,trunk_aa.original_locale
        ,trunk_aa.dbsync_tag
from    (
            select  *
            from    ds_ods.s_trunk_auction_auctions_@@{venture}
            where   ds =3D '${bizdate}'
        ) trunk_aa
;</pre>=20
</div>
</div>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: true; theme: Confluence" data-theme=3D"Confluence">INSERT OV=
ERWRITE TABLE tmp_dim_ds_prd_product_ext PARTITION(ds =3D '${bizdate}',vent=
ure =3D '@@{venture}')
SELECT  auction_id
        ,MAX(is_lorikeet) AS is_lorikeet
        ,MAX(is_pillar) AS is_pillar
FROM    (
            SELECT  auction_id
                    ,1 is_lorikeet
                    ,0 is_pillar
            FROM    ds_ods.s_trunk_auction_description_ml_@@{venture}
            WHERE   ds =3D max_pt('ds_ods.s_trunk_auction_description_ml_@@=
{venture}')
            AND     locale =3D '@@{locale}'
            AND     desc_expand LIKE '%pcPageId%'
            AND     desc_expand LIKE '%wirelessPageId%'
            UNION ALL
            SELECT  product_id
                    ,0 AS is_lorikeet
                    ,1 AS is_pillar
            FROM    ds_activity.nova_ds_channel_manager_product_detail
            WHERE   ds =3D MAX_PT('ds_activity.nova_ds_channel_manager_prod=
uct_detail')
            AND     ARRAY_CONTAINS(SPLIT(product_theme_tag , ','), '37256')
            AND     venture =3D '@@{venture}'
        ) product_ext
GROUP BY auction_id
;

INSERT OVERWRITE TABLE dim_ds_prd_product PARTITION(ds =3D '${bizdate}',ven=
ture =3D '@@{venture}')
SELECT /*+MAPJOIN(ctl,regional,commercial_category,commercial_group,industr=
y_category,commercial_mapping,brand,property_value,seller,return_policy)*/
        aa.auction_id AS product_id
        ,REGEXP_REPLACE(aa.title,'\n|\r|\'|;|,','') AS product_name
        -- ,GET_JSON_OBJECT(aa.attributes, '$.26') as product_name
        ,REGEXP_REPLACE(aa.sub_title,'\n|\r|\'|;|,','') AS product_name_sub
        ,aa.spu_id
        ,aa.seller_id
        ,seller.seller_name AS seller_name
        ,seller.short_code AS seller_short_code
        ,COALESCE(
            --business_type.business_area
            --workaround for digital topup in retail seller
            CASE    WHEN seller.is_retail =3D 1 AND COALESCE(ctl.regional_c=
ategory_key,-1) =3D '300300000000' THEN NULL=20
                    ELSE seller.business_area=20
            END
            ,'Marketplace'
        ) business_area
        ,aa.admin_user_id
        ,aa.category AS category_id
        ,ctl.venture_category_name_en
        ,ctl.venture_category_name_l10n
        ,aa.top_category top_category_id
        ,aa.gmt_create AS create_date
        ,aa.gmt_approve AS qc_date
        ,aa.gmt_modified AS last_modify_date
        ,aa.last_modified AS last_user_modify_date
        ,img.url_main_image
        ,aa.desc_path AS description_path
        ,aa.brand_id
        ,REGEXP_REPLACE(brand.name_en,' ','') AS brand_name
        ,brand.logo AS brand_logo
        ,CASE    WHEN KEYVALUE(property_value.features, 'URL_KEY') IS NOT N=
ULL THEN CONCAT( '@@{venture_url}',KEYVALUE(property_value.features, 'URL_K=
EY'),'/')=20
         END AS brand_url
        ,aa.auction_status AS product_status
        ,aa.approve_status AS product_approval_status
        ,aa.sub_status AS product_sub_approval_status
        ,aa.stuff_status AS product_condition_value
        ,NULL    --aa.attributes
        ,aa.features
        ,aa.user_type
        ,aa.postage_id
        ,aa.options
        ,ctl.parent_category_id
        ,ctl.parent_category_name_en
        ,ctl.parent_category_name_l10n
        ,ctl.category_status
        ,ctl.is_deepest
        ,ctl.regional_category_key
        ,regional.root_or_cross_list AS regional_root_or_cross_list
        ,regional.regional_category1_name
        ,regional.regional_category2_name
        ,regional.regional_category3_name
        ,regional.regional_category4_name
        ,regional.regional_category5_name
        ,regional.regional_category6_name
        ,ctl.venture_category1_id
        ,ctl.venture_category2_id
        ,ctl.venture_category3_id
        ,ctl.venture_category4_id
        ,ctl.venture_category5_id
        ,ctl.venture_category6_id
        ,ctl.venture_category1_name_en
        ,ctl.venture_category1_name_l10n
        ,ctl.venture_category2_name_en
        ,ctl.venture_category2_name_l10n
        ,ctl.venture_category3_name_en
        ,ctl.venture_category3_name_l10n
        ,ctl.venture_category4_name_en
        ,ctl.venture_category4_name_l10n
        ,ctl.venture_category5_name_en
        ,ctl.venture_category5_name_l10n
        ,ctl.venture_category6_name_en
        ,ctl.venture_category6_name_l10n
        ,ctl.level AS venture_category_level
        ,COALESCE(seller.is_taobao_collection,0) is_taobao_collection
        ,seller.seller_status AS seller_account_status
        ,brand.STATUS brand_status
        ,aa.feature_cc
        ,aa.approve_user_id product_approval_user_id
        ,CASE    WHEN seller.is_retail =3D1 THEN sku_info.supplier_code=20
                 ELSE COALESCE(nullif(KEYVALUE(aa.features,'sub_vendor_id')=
,''), seller.short_code)     --vendor is redmart seller
         END AS shop_account_code
        ,CASE    WHEN seller.is_retail =3D1 THEN sku_info.supplier_name=20
                 ELSE COALESCE(nullif(KEYVALUE(aa.features,'sub_vendor_name=
'),''), seller.seller_name)     --vendor is redmart seller
         END AS shop_account_name
        ,commercial_category.commercial_category_name
        ,commercial_mapping.commercial_cluster_name
        ,commercial_group.category_group_name
        ,industry_category.industry_name
        ,CASE    WHEN sku_info.bundle_type IS NOT NULL THEN 1=20
                 ELSE 0=20
         END AS is_budle
        ,sku_info.bundle_type
        ,COALESCE(
            --workaround for digital topup in retail seller
            CASE    WHEN seller.is_retail =3D 1 AND COALESCE(ctl.regional_c=
ategory_key,-1) =3D '300300000000' THEN NULL=20
                    ELSE seller.business_type=20
            END
            ,'ds'
        ) AS business_type
        --workaround for digital topup in retail seller
        ,COALESCE(
            --workaround for digital topup in retail seller
            CASE    WHEN seller.is_retail =3D 1 AND COALESCE(ctl.regional_c=
ategory_key,-1) =3D '300300000000' THEN NULL=20
                    ELSE seller.business_type_level2=20
            END
            -- seller.business_type_level2=20
            ,'ds - MP'
        ) AS business_type_level2
        ,coalesce(KEYVALUE(aa.features,'shop_id'), seller.shop_id) as shop_=
id
        ,return_policy.display_text AS return_policy
        ,img.image_cnt AS image_count
        ,img.image_url_2
        ,img.image_url_3
        ,img.image_url_4
        ,img.image_url_5
        ,COALESCE(
            CASE    WHEN seller.is_retail =3D 1 AND COALESCE(ctl.regional_c=
ategory_key,-1) =3D '300300000000' THEN NULL=20
                    ELSE seller.bu_id=20
            END
            ,4
        ) AS bu_id
        ,COALESCE(prod_ext.is_lorikeet,0) AS is_lorikeet
        ,coalesce(aa.parent_seller_id, seller.parent_seller_id) as parent_s=
eller_id
        ,KEYVALUE(aa.features,'live_test') AS is_test
        ,COALESCE(sku_info.business_application, 'ds') business_application=
    -- Added for Minishop flagging
        ,GET_JSON_OBJECT( aa.attributes ,'@@{venture_video_key}' ) AS exter=
nal_video_url
        ,video.internal_video_uploader
        ,ctl.union_category_id
        ,aa.first_live_date
        ,prod_ext.is_pillar
        ,COALESCE(KEYVALUE(aa.features,'is_sof'),0) AS is_delivered_by_sell=
er
        ,regional.regional_category1_id
        ,regional.regional_category2_id
        ,regional.regional_category3_id
        ,regional.regional_category4_id
        ,regional.regional_category5_id
        ,regional.regional_category6_id
        ,industry_category.industry_id
        ,case when aa.auction_status =3D 1 and aa.sub_status =3D 1 then 'Y'=
 else 'N' end as is_online
        ,DATEDIFF(to_date('${bizdate}','yyyymmdd'), aa.first_live_date,'dd'=
) as fst_online_days
        ,aa.currency_code
        ,aa.original_locale
        ,img.image_names
        ,aa.dbsync_tag
        ,regional.regional_category_name
FROM    (
            SELECT  aa.*
                    ,CASE   WHEN datediff(COALESCE(first_gmt_create, gmt_cr=
eate) , to_date('20190601', 'yyyymmdd')) &lt; 0 then COALESCE(first_gmt_cre=
ate, gmt_create) --20190601=E4=B9=8B=E5=89=8D=E7=9A=84write_trunk_date=E9=
=83=BD=E4=B8=8D=E5=87=86=E7=A1=AE=E9=9C=80=E8=A6=81=E5=85=9C=E5=BA=95
                            WHEN write_trunk_date RLIKE '-|:' THEN write_tr=
unk_date
                            WHEN write_trunk_date RLIKE '^[0-9]+$' THEN sg_=
udf:epoch_to_timezone(CAST ( write_trunk_date AS BIGINT) ,'@@{venture}')=20
                            ELSE COALESCE(first_gmt_create, gmt_create)=20
                    END AS first_live_date
            FROM    ds_cdm.tmp_dim_ds_prd_product_01 aa
            WHERE   ds =3D '${bizdate}'
            AND     venture =3D '@@{venture}'
        ) aa
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.tmp_dim_ds_prd_product_ext
                    WHERE   ds =3D '${bizdate}'
                    AND     venture =3D '@@{venture}'
                ) prod_ext
ON      (prod_ext.auction_id =3D aa.auction_id)
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_product_image
                    WHERE   ds =3D '${bizdate}'
                    AND     venture =3D '@@{venture}'
                ) img
ON      (img.auction_id =3D aa.auction_id)
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.tmp_dim_prd_product_sku_info
                    WHERE   ds =3D '${bizdate}'
                    AND     venture =3D '@@{venture}'
                ) sku_info
ON      (sku_info.auction_id =3D aa.auction_id)
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.tmp_ds_prd_video
                    WHERE   ds =3D '${bizdate}'
                    AND     venture =3D '@@{venture}'
                ) video
ON      video.auction_id =3D aa.auction_id
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_category_tree_local
                    WHERE   ds =3D '${bizdate}'
                    AND     venture =3D '@@{venture}'
                ) ctl
ON      (ctl.category_id =3D aa.category )
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_category_tree_regional
                    WHERE   ds =3D '${bizdate}'
                ) regional
ON      (regional.regional_category_key =3D ctl.regional_category_key )
LEFT OUTER JOIN (
                    SELECT  DISTINCT *
                    FROM    ds_cdm.dim_ds_prd_commercial_category
                    WHERE   ds =3D '${bizdate}'
                ) commercial_category
ON      (commercial_category.regional_category_key =3D regional.regional_ca=
tegory_key )
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_commercial_group
                    WHERE   ds =3D '${bizdate}'
                ) commercial_group
ON      (commercial_group.category1_name =3D regional.regional_category1_na=
me )
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_industry_category
                    WHERE   ds =3D '${bizdate}'
                ) industry_category
ON      (industry_category.regional_category_key =3D regional.regional_cate=
gory_key )
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_cdm.dim_ds_prd_commercial_mapping
                    WHERE   ds =3D max_pt('ds_cdm.dim_ds_prd_commercial_map=
ping')
                ) commercial_mapping
ON      (
            commercial_mapping.commercial_category_name =3D commercial_cate=
gory.commercial_category_name
        )
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_ods.s_std_brand
                    WHERE   ds =3D '${bizdate}'
                    and  nation  =3D '@@{venture}'
                ) brand
ON      (brand.brand_id =3D aa.brand_id)
LEFT OUTER JOIN (
                    SELECT  *
                    FROM    ds_ods.s_std_property_values
                    WHERE   ds =3D '${bizdate}'
                    AND     property_id =3D 20000
                    AND     STATUS =3D 0
                    and     nation =3D '@@{venture}'
                ) property_value
ON      (property_value.value_id =3D brand.brand_id)
LEFT OUTER JOIN (
        SELECT  seller_id
                ,seller_name
                ,short_code
                ,seller_status
                ,is_seller_crossborder
                ,business_area
                ,business_type
                ,business_type_level2
                ,bu_id
                ,is_marketplace
                ,is_retail
                ,parent_seller_id
                ,is_taobao_collection
                ,shop_id
        FROM    ds_cdm.dim_ds_slr_seller
        WHERE   ds =3D '${bizdate}'
        AND     venture =3D '@@{venture}'
        AND     '${bizdate}' &lt; TO_CHAR(DATEADD(GETDATE(),-1,'dd'),'yyyym=
mdd')
        UNION ALL
        SELECT  seller_id
                ,seller_name
                ,seller_short_code as short_code
                ,account_status as seller_status
                ,is_crossborder as is_seller_crossborder
                ,business_area
                ,business_type
                ,business_type_level2
                ,CAST(bu_id AS BIGINT)
                ,is_marketplace
                ,is_retail
                ,parent_id as parent_seller_id
                ,is_taobao_collection
                ,shop_id
        FROM    ds_cdm.dim_ds_slr_seller_basic_@@{venture}
        WHERE   '${bizdate}' =3D TO_CHAR(DATEADD(GETDATE(),-1,'dd'),'yyyymm=
dd')
) seller
ON      (seller.seller_id =3D aa.seller_id)
LEFT OUTER JOIN (
                    SELECT  reverse_dict_id
                            ,display_text
                    FROM    ds_ods.s_reverse_dict_config_@@{venture}
                    WHERE   ds =3D '${bizdate}'
                ) return_policy
ON      (return_policy.reverse_dict_id =3D aa.return_policy)
;
--add a view here

CREATE OR REPLACE VIEW dim_ds_prd_product_@@{venture} AS
SELECT  `(row_filter)?+.+`
FROM    dim_ds_prd_product
WHERE   ds =3D '${bizdate}'
AND     venture =3D '@@{venture}'
;</pre>=20
</div>
</div>
