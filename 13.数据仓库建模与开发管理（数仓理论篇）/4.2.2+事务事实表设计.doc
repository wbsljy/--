<p><span>4. SQL=E8=84=9A=E6=9C=AC</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">INSERT I=
NTO dwd_dsbidata_orders_di (
    order_date_key,
    customer_key,
    product_key,
    order_id,
    quantity,
    amount
)
SELECT
    dd.date_key AS order_date_key,
    dc.customer_key AS customer_key,
    dp.product_key AS product_key,
    so.order_id,
    so.quantity,
    so.amount
FROM
    ods_dsbidata_orders so
    JOIN dim_dsbidata_date dd ON DATE(so.order_date) =3D dd.date
    JOIN dim_dsbidata_customer dc ON so.customer_id =3D dc.customer_id
    JOIN dim_dsbidata_product dp ON so.product_id =3D dp.product_id
WHERE
    so.order_date BETWEEN '2025-10-01' AND '2025-10-02';  -- =E5=A2=9E=E9=
=87=8F=E6=8A=BD=E5=8F=96=E6=9D=A1=E4=BB=B6

</pre>=20
