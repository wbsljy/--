=97=A5=E6=9C=9F=E7=BB=B4=E5=BA=A6=E8=A1=A8
CREATE TABLE dim_dsbidata_date (
    date_key INT PRIMARY KEY,  -- =E6=A0=BC=E5=BC=8F=EF=BC=9AYYYYMMDD
    date DATE,
    year INT,
    quarter INT,
    month INT,
    day INT
);

-- =E5=AE=A2=E6=88=B7=E7=BB=B4=E5=BA=A6=E8=A1=A8
CREATE TABLE dim_dsbidata_customer (
    customer_key INT PRIMARY KEY,
    customer_id INT,
    name VARCHAR(50),
    city VARCHAR(50)
);

-- =E4=BA=A7=E5=93=81=E7=BB=B4=E5=BA=A6=E8=A1=A8
CREATE TABLE dim_dsbidata_product (
    product_key INT PRIMARY KEY,
    product_id INT,
    product_name VARCHAR(50),
    category VARCHAR(50)
);

</pre>=20
