</ul>
<p><span style=3D"color: rgb(0,0,0);">=E4=BB=A3=E7=A0=81:&nbsp;</span></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">WITH t_p=
ro_collect AS=20
(
    SELECT  record_id AS id
            ,user_id
            ,utdid
            ,benefit_type
            ,biz_code
            ,ref_record_id
            ,benefit_id
            ,ref_benefit_id
            ,benefit_group_id
            ,benefit_group_scene
            ,hit_user_group_codes
            ,value_amount
            ,min_spend as min_spend_pro
            ,cap as cap_pro
            ,discount_type
            ,voucher_pool_id AS pool_id
            ,CASE   WHEN COALESCE(entrance_tag_union_id,tag_union_id) =3D 2=
0220101
                        AND CAST(benefit_id AS BIGINT) &lt; 0 THEN 0
                    ELSE 1
            END AS is_pro_config
            ,NVL(entrance_tag_id,tag_id) AS tag_id
            ,NVL(entrance_module_id,module_id) AS module_id
            ,NVL(entrance_page_id,page_id) AS page_id
            ,NVL(entrance_channel_id,channel_id) AS channel_id
            ,NVL(entrance_tag_union_id,tag_union_id) AS tag_union_id
            ,allocation_plan_id AS plan_id
            ,parent_plan_id
            ,ext_source
            ,final_redemption_score
            ,final_redemption_gmv
            ,final_redemption_amount
            ,collect_type
            ,status
            ,exposure_id
            ,algo_bucket_id
            ,t_collect.collect_timestamp
            ,t_collect.expire_timestamp
            ,site_id AS venture
            ,t_collect_track.collect_track AS collect_track_info
    FROM   =20
    (
                SELECT  *
                FROM    ds_mkt.dwd_ds_benefit_collect_record_di
                WHERE   ds =3D '${bizdate}'
                AND     site_id =3D '@@{venture}'
    ) t_collect
    LEFT JOIN  =20
    (
                SELECT  id
                        ,venture
                        ,collect_track
                FROM    (
                            SELECT  *
                                    ,ROW_NUMBER() OVER (PARTITION BY ref_re=
cord_id,venture ORDER BY log_time DESC ) AS rn
                            FROM    ds_mkt.dwd_ds_benefit_track_log_di
                            WHERE   ds =3D '${bizdate}'
                            AND     venture =3D '@@{venture}'
                        )=20
                WHERE   rn =3D 1
    ) t_collect_track
    ON      t_collect.record_id =3D t_collect_track.id
    AND     t_collect.site_id =3D t_collect_track.venture
)
,t_tag AS=20
(
    SELECT  tag_id
            ,tag_name
            ,tag_union_id
            ,channel_id AS scene_id
            ,channel_name AS scene_name
            ,page_id
            ,page_name
            ,module_id
            ,module_name
            ,venture
    FROM    ds_mkt.dim_ds_pro_spmt_new
    WHERE   ds =3D MAX_PT('ds_mkt.dim_ds_pro_spmt_new')
    AND     venture =3D '@@{venture}'
)
,t_plan AS=20
(
    SELECT  plan_id
            ,plan_name
            ,venture
    FROM    ds_mkt.dim_ds_pro_plan_new
    WHERE   ds =3D MAX_PT('ds_mkt.dim_ds_pro_plan_new')
    AND     venture =3D '@@{venture}'
)
,t_voucher_pool AS=20
(
    SELECT  pool_id
            ,pool_name
            ,venture
    FROM    ds_mkt.dim_ds_pro_pool_new
    WHERE   ds =3D MAX_PT('ds_mkt.dim_ds_pro_pool_new')
    AND     venture =3D '@@{venture}'
)

INSERT OVERWRITE  TABLE dwd_ds_pro_voucher_collect_di PARTITION(ds=3D'${biz=
date}',venture=3D'@@{venture}')
SELECT=20
    /*+ MAPJOIN(t_channel,t_tag,voucher_plan,voucher_pool) * /
    pro.id
    ,pro.ref_record_id  as collect_id
    ,pro.benefit_id
    ,pro.ref_benefit_id  AS promotion_id=20
    ,pro.collect_timestamp
    ,TO_CHAR(
            sg_udf.epoch_to_timezone(pro.collect_timestamp,pro.venture)
            ,'yyyymmdd'
        ) as collect_date
    ,pro.user_id
    ,pro.utdid AS utdid
    ,promotion.tool_code
    ,CASE WHEN pro.discount_type =3D 1 THEN 'fixed_amount'
        WHEN pro.discount_type =3D 2 THEN 'percent_amount'
        ELSE pro.discount_type END  AS voucher_type=20
    ,promotion.is_dynamic=20
    ,pro.collect_track_info
    ,COALESCE(pro.parent_plan_id,pro.plan_id,'-999') as  plan_id
    ,COALESCE(voucher_plan.plan_name,'unknown') AS plan_name
    ,COALESCE(pro.channel_id,'-999') AS scene_id
    ,COALESCE(t_channel.scene_name,'unknown') AS scene_name
    ,COALESCE(pro.page_id,t_tag.page_id,'-999') AS page_id
    ,COALESCE(t_tag.page_name,'unknown') AS page_name
    ,COALESCE(pro.module_id,t_tag.module_id,'-999') AS module_id
    ,COALESCE(t_tag.module_name,'unknown') AS module_name
    ,COALESCE(pro.tag_id,'-999') AS tag_id
    ,COALESCE(t_tag.tag_name,'unknown') AS tag_name
    ,COALESCE(pro.tag_union_id,t_tag.tag_union_id,'-999') AS tag_union_id
    ,COALESCE(pro.pool_id,'-999') AS pool_id
    ,COALESCE(voucher_pool.pool_name,'unknown') AS pool_name
    ,COALESCE(benefit_group_id,'-999')  AS benefit_group_id
    ,COALESCE(is_pro_config,0) AS is_pro_config
    ,pro.hit_user_group_codes
    ,pro.benefit_group_scene
    ,pro.ext_source
    ,CONCAT(
         NVL(CONCAT('discount_type:',discount_type,';'),'')
        ,NVL(CONCAT('cap_pro:',cap_pro,';'),'')
        ,NVL(CONCAT('min_spend_pro:',min_spend_pro,';'),'')
        ,NVL(CONCAT('value_amount:',value_amount,';'),'')
    ) AS extra_info
    ,final_redemption_score
    ,final_redemption_gmv
    ,final_redemption_amount
    ,algo_bucket_id
    ,collect_type
    ,exposure_id
    ,pro.expire_timestamp
    ,status as collect_status
    ,pro.benefit_type=20
    ,COALESCE(promotion.biz_code,'unknown') AS biz_code
    ,COALESCE(promotion.biz_lvll1_code,'unknown') AS biz_lvll1_code
    ,COALESCE(promotion.biz_lvll1_name,'unknown') AS biz_lvll1_name
    ,COALESCE(promotion.biz_lvll2_code,'unknown') AS biz_lvll2_code
    ,COALESCE(promotion.biz_lvll2_name,'unknown') AS biz_lvll2_name
    ,COALESCE(promotion.biz_lvll3_code,'unknown') AS biz_lvll3_code
    ,COALESCE(promotion.biz_lvll3_name,'unknown') AS biz_lvll3_name
FROM t_pro_collect pro=20
LEFT JOIN=20
(
    SELECT=20
            /*+ MAPJOIN (pro_biz)*/
            t_promo.promotion_id
            ,t_promo.venture
            ,t_promo.tool_code
            ,t_promo.biz_code
            ,t_promo.is_dynamic
            ,pro_biz.biz_lvll1_code
            ,pro_biz.biz_lvll1_name
            ,pro_biz.biz_lvll2_code
            ,pro_biz.biz_lvll2_name
            ,pro_biz.biz_lvll3_code
            ,pro_biz.biz_lvll3_name
    FROM=20
    (
            SELECT=20
                prom_id  as promotion_id=20
                ,venture
                ,tool_code
                ,biz_code
                ,is_dynamic
            FROM ds_cdm.dim_aidc_ds_prom
            WHERE ds =3D '${bizdate}'
            AND venture =3D'@@{venture}'
    )  t_promo
    LEFT JOIN ds_cdm.dim_ds_pro_voucher_biz pro_biz
    ON      t_promo.biz_code =3D pro_biz.biz_code
) promotion
ON  pro.ref_benefit_id =3D promotion.promotion_id
LEFT JOIN  =20
(
            SELECT  id AS scene_id
                    ,channel_name AS scene_name
            FROM    ds_tech.dwd_ds_stars_sg_s_stars_channel_new
            WHERE   ds =3D MAX_PT('ds_tech.dwd_ds_stars_sg_s_stars_channel_=
new')
            AND     venture =3D 'ALL'
            AND     env =3D 'PRD'
) t_channel
ON      pro.channel_id =3D t_channel.scene_id
LEFT JOIN t_tag  t_tag
ON      pro.tag_id =3D t_tag.tag_id
LEFT JOIN t_plan voucher_plan
ON      pro.parent_plan_id =3D voucher_plan.plan_id
LEFT JOIN t_voucher_pool voucher_pool
ON      pro.pool_id =3D voucher_pool.pool_id
;


CREATE OR REPLACE VIEW dwd_ds_pro_voucher_collect_di_@@{venture}
AS SELECT * FROM dwd_ds_pro_voucher_collect_di
WHERE venture =3D '@@{venture}'
;</pre>=20
</div>
</div>
<p><br></p>
<p>=E2=80=8C</p>
