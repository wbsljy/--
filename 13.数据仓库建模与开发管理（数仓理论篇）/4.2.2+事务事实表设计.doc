=AE=A2=E5=8D=95=E8=A1=A8 (=E6=BA=90=E7=B3=BB=E7=BB=9F)
CREATE TABLE ods_dsbidata_orders (
    order_id INT PRIMARY KEY,
    customer_id INT,
