rning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >2.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >增量更新：通过</font>&nbsp;FULL OUTER JOIN&nbsp;合并前一日全量数据和当日增量数据，更新对应字段。</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l3 level1 lfo20;" ><![if !supportLists]><span style=3D"font-family:宋体;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >3.<span>&nbsp;</span></span></span><![endif]><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >适用场景：适合数据量较小、需要频繁查询历史快照的场景（如订单状态跟踪）。</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h2 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >方法</font><font face=3D"宋体" >2：最近n天的df表 + 历史数据的归档di表</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:宋体;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >存储：</font>2个物理表，1个df表，存储最近n天的全量数据；一个di表，存储n天以前每天的归档不变数据</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >计算：每天更新最近</font>n天数据到df表；同时更新前 n+1 天数据到di表</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >优点：节约存储，</font>df表能满足大部分场景需求；可在df表的生命周期内，满足历史状态数据的查询</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >缺点：计算和存储都会消耗很大，数据量特别大的时候，有可能数据无法产出或时间过长</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >1. 表结构定义</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >假设</font>&nbsp;n=3D3&nbsp;天（保留最近3天的全量数据），定义两个表：df表（动态全量表，存储最近3天数据）,di表（历史归档表，存储3天前数据）</span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span><img width=3D"468"  height=3D"127"  src=3D"~tmp{cb0f315f-5a54-4f6a-9a3f-1c3ab677865e}1576310.files/~tmp{cb0f315f-5a54-4f6a-9a3f-1c3ab677865e}157631010991.png" ></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >CREATE TABLE dwd_xxx_order_snapshot_df (</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >order_id &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;STRING COMMENT '订单ID',</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >customer_id &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;STRING COMMENT '客户ID',</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >created_time &nbsp;&nbsp;&nbsp;&nbsp;TIMESTAMP COMMENT '订单创建时间',</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >paid_time &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;TIMESTAMP COMMENT '支付时间',</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >shipped_time &nbsp;&nbsp;&nbsp;&nbsp;TIMESTAMP COMMENT '发货时间',</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" >&nbsp;&nbsp;&nbsp;&nbsp;<font face=3D"宋体" >cancelled_time &nbsp;&nbsp;TIMESTAMP COMMENT '取消时间'</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >)</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >PARTITIONED BY (dt STRING COMMENT '分区日期') &nbsp;-- 按天分区，仅存储最近3天数据</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >STORED AS ORC</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"宋体" >; &nbsp;</font></span><span style=3D"mso-spacerun:'yes';font-family:宋体;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dpre  style=3D"mso-pagination:widow-orphan;" ><span styl