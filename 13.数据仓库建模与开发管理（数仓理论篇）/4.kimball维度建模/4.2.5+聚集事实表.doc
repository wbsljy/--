uto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 72.0000pt ;mso-pagination:widow-orphan;mso-list:l1 level2 lfo1;" ><![if !supportLists]><span style=3D"font-family:微软雅黑;mso-ascii-font-family:'Courier New';mso-hansi-font-family:'Courier New';=20mso-bidi-font-family:'Courier New';font-size:10.0000pt;mso-font-kerning:0.0000pt;" ><span style=3D'mso-list:Ignore;' >o<span style=3D'font:7.0pt Times New Roman' >&nbsp;</span></span></span><![endif]><span><a href=3D"#id-4.2.5聚集事实表-case2:券领取汇总表(重度汇总表)" ><u><span class=3D"15"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20text-decoration:underline;text-underline:single;" ><font face=3D"微软雅黑" >case2: 券领取汇总表(重度汇总表)</font></span></u></a></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >1.定义</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >聚集事实表与周期性快照表类似，在《数据仓库工具箱》书中将可加指标的汇总和上卷定义为聚集事实表，</font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >和周期快照事实表的区别</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >在于</font></span><b style=3D"mso-bidi-font-weight:normal" ><span class=3D"16"  style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20mso-ansi-font-weight:bold;" ><font face=3D"微软雅黑" >度量的可加性</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><br></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(23,43,77);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >例如：差旅数据模型设计中每日统计财年至今差旅费用表</font><font face=3D"微软雅黑" >YTD（周期快照事实表）和部门月差旅费用汇总表CM（聚集事实表）都当作指标表对待。</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >2.使用场景</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><p class=3Dp  style=3D"mso-pagination:widow-orphan;text-align:left;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(25,26,31);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >我们在设计数据仓库</font><font face=3D"微软雅黑" >dws层中, 我们设计了很多的轻度或者重度汇总表，通过按照不同的维度进行汇总，比如买家、卖家、商品、类目、BC类型等等，计算最近1天、7天、30天、90天等下单子订单数、支付金额等等这些指标，具体的表命名体现出来的，其中1d结尾就表示最近1天的汇总，nd结尾表示的是最近多天的汇总。聚集事实表就包括这两类, </font></span><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(255,0,0);=20font-weight:bold;font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >dws层大部分是这一类聚集事实表, 还有一部分非聚集事实表</font></span></b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(25,26,31);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >;&nbsp;</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h1 style=3D"mso-pagination:widow-orphan;text-align:left;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(0,0,255);=20font-weight:bold;font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><font face=3D"微软雅黑" >3.企业案例</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:24.0000pt;mso-font-kerning:22.0000pt;" ><o:p></o:p></span></b></h1><h2 style=3D"mso-pagination:widow-orphan;" ><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(25,26,31);=20font-weight:bold;font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >case1:&nbsp; 用户核销金币汇总表(轻度汇总)</font></span></b><b><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-weight:bold;=20font-size:18.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h2><p class=3Dp  style=3D"mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;color:rgb(25,26,31);=20font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >需求说明</font><font face=3D"微软雅黑" >: 计算每个用户核心金币情况;&nbsp;</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3Dp  style=3D"margin-top:5.0000pt;margin-right:0.0000pt;margin-bottom:5.0000pt;=20margin-left:0.0000pt;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;=20mso-pagination:widow-orphan;" ><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><font face=3D"微软雅黑" >数据来源说明</font><font face=3D"微软雅黑" >:&nbsp;</font></span><span style=3D"mso-spacerun:'yes';font-family:微软雅黑;font-size:12.0000pt;=20mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal  style=3D"margin-top:5.0000pt;margin-bottom:5.0000pt;margin-left:36.0000pt;=20mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;text-indent:-18.0000pt;=20tab-stops:left blank 36.0000pt ;mso-pagination:widow-orphan;mso-list:l2 