=A3=E7=A0=81=E5=AE=9E=E7=8E=B0">3.2 =E4=BB=A3=E7=A0=81=E5=AE=9E=E7=8E=B0</h=
2>
<h3 id=3D"id-4.2.1=E4=BA=8B=E5=AE=9E=E8=A1=A8=E5=9F=BA=E7=A1=80-3.2.1=E4=BA=
=8B=E5=AE=9E=E8=A1=A8=E8=AE=BE=E8=AE=A1=EF=BC=88dwd_ds_order_payment_di=EF=
=BC=89">3.2.1 =E4=BA=8B=E5=AE=9E=E8=A1=A8=E8=AE=BE=E8=AE=A1=EF=BC=88dwd_ds_=
order_payment_di=EF=BC=89</h3>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">
CREATE TABLE dwd_ds_order_payment_di (
    -- =E4=B8=BB=E9=94=AE=E5=8F=8A=E7=B2=92=E5=BA=A6=E6=A0=87=E8=AF=86
    order_id STRING COMMENT '=E5=AD=90=E8=AE=A2=E5=8D=95ID',
    parent_order_id STRING COMMENT '=E7=88=B6=E8=AE=A2=E5=8D=95ID',
   =20
    -- =E7=BB=B4=E5=BA=A6=E5=A4=96=E9=94=AE=EF=BC=88=E6=A0=87=E5=87=86=E5=
=8C=96=E9=83=A8=E5=88=86=EF=BC=89
    user_id STRING COMMENT '=E7=94=A8=E6=88=B7ID',
    item_id STRING COMMENT '=E5=95=86=E5=93=81ID',
    seller_id STRING COMMENT '=E5=8D=96=E5=AE=B6ID',
    region_id INT COMMENT '=E5=9C=B0=E5=9F=9FID',
    channel_id INT COMMENT '=E6=B8=A0=E9=81=93ID',
    order_dt TIMESTAMP COMMENT '=E8=AE=A2=E5=8D=95=E6=97=A5=E6=9C=9F',
   =20
    -- =E5=86=97=E4=BD=99=E7=BB=B4=E5=BA=A6=EF=BC=88=E5=B8=B8=E7=94=A8=E7=
=BB=B4=E5=BA=A6=EF=BC=89
    user_level STRING COMMENT '=E7=94=A8=E6=88=B7=E7=AD=89=E7=BA=A7',
    item_category STRING COMMENT '=E5=95=86=E5=93=81=E7=B1=BB=E7=9B=AE',
    seller_name STRING COMMENT '=E5=BA=97=E9=93=BA=E5=90=8D=E7=A7=B0',
    province STRING COMMENT '=E6=94=B6=E8=B4=A7=E7=9C=81=E4=BB=BD',
   =20
    -- =E4=BA=8B=E5=AE=9E=E5=BA=A6=E9=87=8F
    payment_amount DECIMAL(18,2) COMMENT '=E5=AE=9E=E4=BB=98=E9=87=91=E9=A2=
=9D',
    shipping_fee DECIMAL(18,2) COMMENT '=E8=BF=90=E8=B4=B9',
    discount_amount DECIMAL(18,2) COMMENT '=E4=BC=98=E6=83=A0=E9=87=91=E9=
=A2=9D',
    quantity INT COMMENT '=E8=B4=AD=E4=B9=B0=E6=95=B0=E9=87=8F',
   =20
    -- =E4=B8=9A=E5=8A=A1=E8=BF=87=E7=A8=8B=E6=A0=87=E8=AE=B0
    is_paid TINYINT COMMENT '=E6=98=AF=E5=90=A6=E4=BB=98=E6=AC=BE',
    is_shipped TINYINT COMMENT '=E6=98=AF=E5=90=A6=E5=8F=91=E8=B4=A7'
) PARTITIONED BY (ds STRING);


</pre>=20
</div>
</div>
<h3 id=3D"id-4.2.1=E4=BA=8B=E5=AE=9E=E8=A1=A8=E5=9F=BA=E7=A1=80-3.2.2ETL=E8=
=84=9A=E6=9C=AC:ODS=E5=B1=82=E5=88=B0DWD=E5=B1=82=E5=A4=84=E7=90=86">3.2.2 =
ETL=E8=84=9A=E6=9C=AC : ODS=E5=B1=82=E5=88=B0DWD=E5=B1=82=E5=A4=84=E7=90=86=
</h3>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">=20
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: sql; gutter: false; theme: Confluence" data-theme=3D"Confluence">INSERT O=
VERWRITE TABLE dwd_ds_order_payment_di PARTITION(ds=3D'${bizdate}')
SELECT=20
    o.sub_order_id AS order_id,
    o.parent_order_id,
    -- =E7=BB=B4=E5=BA=A6=E5=A4=96=E9=94=AE
    o.buyer_id AS user_id,
    o.item_id,
    o.seller_id,
    r.region_id,
    c.channel_id,
    o.create_time AS order_dt,
    -- =E5=86=97=E4=BD=99=E7=BB=B4=E5=BA=A6
    u.user_level,
    i.category_path AS item_category,
    s.shop_name AS seller_name,
    r.province,
    -- =E4=BA=8B=E5=AE=9E=E5=BA=A6=E9=87=8F
    o.payment_amount,
    o.shipping_fee,
    o.discount_amount,
    o.quantity,
    -- =E4=B8=9A=E5=8A=A1=E7=8A=B6=E6=80=81
    CASE WHEN o.pay_time IS NOT NULL THEN 1 ELSE 0 END AS is_paid,
    CASE WHEN o.ship_time IS NOT NULL THEN 1 ELSE 0 END AS is_shipped
FROM ods_ds_orders o
LEFT JOIN dim_ds_user u ON o.buyer_id =3D u.user_id
LEFT JOIN dim_ds_item i ON o.item_id =3D i.item_id
LEFT JOIN dim_ds_seller s ON o.seller_id =3D s.seller_id
LEFT JOIN dim_ds_region r ON o.receiver_district =3D r.district_code
LEFT JOIN dim_ds_channel c ON o.order_source =3D c.channel_code
WHERE o.create_time =3D '${bizdate}';</pre>=20
</div>
</div>
<p><br></p>
<p><br></p>
    </div>
</body>
</html>
